<%- include('header') %>
<% const closed = Boolean(animal.closedAt) || animal.adoptionStatus === 'adopted'; %>
<div class="page-heading">
    <div>
        <span class="eyebrow">ANIMAL PROFILE</span>
        <div class="animal-title">
            <span class="detail-pet animal-avatar-<%= animal.animalType %>">
                <%- include('icon', { name: ['cat', 'dog'].includes(animal.animalType) ? animal.animalType : 'paw' }) %>
            </span>
            <h1>Animal Details</h1>
        </div>
        <div class="record-code">
            <code>
                <%= animal.animalCode %>
            </code>
            <button type="button" data-copy="<%= animal.animalCode %>">Copy Code</button>
        </div>
        <p>Registered: <%= formatDate(animal.createdAt) %> · Updated: <%= formatDate(animal.updatedAt) %>
        </p>
    </div>
    <a class="button" href="/animals">Back to List</a>
</div>
<% if (closed) { %>
<p class="form-feedback" role="status"><%- include('icon', { name: 'lock' }) %>This case is closed. The archived record is read-only.</p>
<% } %>
<nav class="case-navigation" aria-label="This animal record">
    <a href="#case-summary">Overview</a>
    <a href="#care-journal">Care Journal <span><%= followUps.length %></span></a>
    <a href="#adoption-history">Adoption History <span><%= adoptionRecords.length %></span></a>
</nav>
<div class="columns" id="case-summary">
    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon"><%- include('icon', { name: 'paw' }) %></span>Basic Information
        </h2>
        <dl>
            <dt>Animal Type</dt>
            <dd>
                <%= labels.animalTypes[animal.animalType] %>
            </dd>
            <dt>Appearance</dt>
            <dd>
                <%= animal.appearance %>
            </dd>
            <dt>Found Location</dt>
            <dd>
                <%= animal.foundLocation %>
            </dd>
            <dt class="icon-heading"><%- include('icon', { name: 'care' }) %>Health Condition</dt>
            <dd>
                <%= animal.healthStatus %>
            </dd>
            <dt>Contact Name</dt>
            <dd>
                <%= animal.contactName %>
            </dd>
            <dt>Phone Number</dt>
            <dd>
                <%= animal.contactPhone %>
            </dd>
            <dt>Registered By</dt>
            <dd>
                <%= userName(animal.createdBy) %>
            </dd>
        </dl>
        <% if (!closed) { %>
        <a class="button" href="/animals/<%= animal._id %>/edit">Edit Details</a>
        <% } %>
    </section>
    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon"><%- include('icon', { name: 'care' }) %></span>Rescue & Adoption Status
        </h2>
        <dl>
            <dt>Rescue Progress</dt>
            <dd>
                <span class="badge status-<%= animal.rescueStatus %>">
                    <%= labels.rescueStatuses[animal.rescueStatus] %>
                </span>
            </dd>
            <dt>Assigned To</dt>
            <dd>
                <%= unassigned ? 'Unassigned' : userName(animal.assignedTo) %>
            </dd>
            <dt>Placement Location</dt>
            <dd>
                <%= animal.placementLocation || 'Not arranged' %>
            </dd>
            <dt>Adoption Status</dt>
            <dd>
                <span class="badge status-<%= animal.adoptionStatus %>">
                    <%= labels.adoptionStatuses[animal.adoptionStatus] %>
                </span>
            </dd>
            <dt>Case Status</dt>
            <dd>
                <%= closed ? 'Closed · Archived' : 'Open' %>
            </dd>
            <% if (animal.closedAt) { %>
            <dt>Closed At</dt>
            <dd>
                <%= formatDate(animal.closedAt) %>
            </dd>
            <dt>Closed By</dt>
            <dd>
                <%= userName(animal.closedBy) %>
            </dd>
            <% } %>
        </dl>
        <% if (!closed) { %>
        <div class="actions">
            <a class="button" href="/animals/<%= animal._id %>/rescue">Rescue Management</a>
            <a class="button" href="/animals/<%= animal._id %>/adoption">Adoption Management</a>
        </div>
        <% } %>
    </section>
</div>
<section class="panel spaced" id="adoption-history">
    <h2 class="icon-heading">
        <span class="heading-icon"><%- include('icon', { name: 'heart' }) %></span>Adoption History
    </h2>
    <% if (!adoptionRecords.length) { %>
    <p>No adoption registered yet.</p>
    <% } %>
    <% adoptionRecords.forEach(record => { %>
    <article class="history">
        <span
            class="badge <%= record.cancelledAt ? 'status-cancelled' : record.completedAt ? 'status-adopted' : 'status-processing' %>">
            <%= record.cancelledAt ? 'Cancelled' : record.completedAt ? 'Completed' : 'In Progress' %>
        </span>
        <dl class="spaced">
            <dt>Adopter</dt>
            <dd>
                <%= record.adopterName %>
            </dd>
            <dt>Phone Number</dt>
            <dd>
                <%= record.adopterPhone %>
            </dd>
            <dt>Notes</dt>
            <dd>
                <%= record.remarks || '—' %>
            </dd>
            <dt>Registered By</dt>
            <dd>
                <%= userName(record.registeredBy) %>
            </dd>
            <dt>Registered At</dt>
            <dd>
                <%= formatDate(record.createdAt) %>
            </dd>
            <dt>Completed At</dt>
            <dd>
                <%= formatDate(record.completedAt) %>
            </dd>
            <% if (record.cancelledAt) { %>
            <dt>Cancellation Reason</dt>
            <dd>
                <%= record.cancellationReason %>
            </dd>
            <dt>Cancelled At</dt>
            <dd>
                <%= formatDate(record.cancelledAt) %>
            </dd>
            <dt>Cancelled By</dt>
            <dd>
                <%= userName(record.cancelledBy) %>
            </dd>
            <% } %>
        </dl>
    </article>
    <% }) %>
</section>
<section class="panel spaced care-journal" id="care-journal">
    <h2 class="icon-heading">
        <span class="heading-icon"><%- include('icon', { name: 'notes' }) %></span>Follow-up Records
    </h2>
    <% if (!closed) { %>
    <a class="button" href="/animals/<%= animal._id %>/followups/new"><%- include('icon', { name: 'notes-plus' }) %>Add Follow-up</a>
    <% } %>
    <% if (!followUps.length) { %>
    <p>No follow-up records yet.</p>
    <% } %>
    <% followUps.forEach(item => { %>
    <article class="history">
        <small>
            <%= formatDate(item.createdAt) %> ·
            <%= userName(item.recordedBy) %>
        </small>
        <p>
            <%= item.content %>
        </p>
        <% if (item.updatedBy) { %>
        <small>Last edited: <%= userName(item.updatedBy) %> ·
            <%= formatDate(item.updatedAt) %>
        </small>
        <% } %>
        <% if (!closed && currentUser && (currentUser.role === 'admin' || String(item.recordedBy?._id || item.recordedBy) === String(currentUser._id))) { %>
        <div class="actions">
            <a class="text-link" href="/animals/<%= animal._id %>/followups/<%= item._id %>/edit"><%- include('icon', { name: 'edit' }) %>Edit</a>
            <a class="text-link danger-text"
                href="/animals/<%= animal._id %>/followups/<%= item._id %>/delete"><%- include('icon', { name: 'delete' }) %>Delete</a>
        </div>
        <% } %>
    </article>
    <% }) %>
</section>
<%- include('footer') %>
