<%- include('header') %>
<% const closed = Boolean(animal.closedAt) || animal.adoptionStatus === 'adopted'; %>
<div class="page-heading"><div><span class="eyebrow">ANIMAL PROFILE</span><h1><%= animal.animalCode %> · 动物详情</h1><p>登记时间：<%= formatDate(animal.createdAt) %> · 最近更新：<%= formatDate(animal.updatedAt) %></p></div><a class="button" href="/animals">返回列表</a></div>
<% if (closed) { %><p class="form-feedback" role="status">已结案，档案保留，只供查看。</p><% } %>
<div class="columns"><section class="panel"><h2>基本资料</h2><dl>
<dt>动物类型</dt><dd><%= labels.animalTypes[animal.animalType] %></dd>
<dt>外观描述</dt><dd><%= animal.appearance %></dd>
<dt>发现地点</dt><dd><%= animal.foundLocation %></dd>
<dt>健康状况</dt><dd><%= animal.healthStatus %></dd>
<dt>联系人</dt><dd><%= animal.contactName %></dd>
<dt>联系电话</dt><dd><%= animal.contactPhone %></dd>
<dt>登记人</dt><dd><%= userName(animal.createdBy) %></dd></dl>
<% if (!closed) { %><a class="button" href="/animals/<%= animal._id %>/edit">编辑基本资料</a><% } %>
</section><section class="panel"><h2>救助与领养状态</h2><dl>
<dt>救助进度</dt><dd><span class="badge status-<%= animal.rescueStatus %>"><%= labels.rescueStatuses[animal.rescueStatus] %></span></dd>
<dt>负责人</dt><dd><%= userName(animal.assignedTo) %></dd>
<dt>安置地点</dt><dd><%= animal.placementLocation || '待安排' %></dd>
<dt>领养状态</dt><dd><span class="badge status-<%= animal.adoptionStatus %>"><%= labels.adoptionStatuses[animal.adoptionStatus] %></span></dd>
<dt>结案状态</dt><dd><%= closed ? '已结案 · 保留档案' : '未结案' %></dd>
<% if (animal.closedAt) { %><dt>结案时间</dt><dd><%= formatDate(animal.closedAt) %></dd><dt>结案人</dt><dd><%= userName(animal.closedBy) %></dd><% } %>
</dl><% if (!closed) { %><div class="actions"><a class="button" href="/animals/<%= animal._id %>/rescue">救助管理</a><a class="button" href="/animals/<%= animal._id %>/adoption">领养管理</a></div><% } %></section></div>
<section class="panel spaced"><h2>领养记录</h2>
<% if (!adoptionRecords.length) { %><p>暂无领养登记。</p><% } %>
<% adoptionRecords.forEach(record => { %><article class="history"><dl>
<dt>领养人</dt><dd><%= record.adopterName %></dd><dt>联系电话</dt><dd><%= record.adopterPhone %></dd>
<dt>备注</dt><dd><%= record.remarks || '—' %></dd><dt>登记人</dt><dd><%= userName(record.registeredBy) %></dd>
<dt>登记时间</dt><dd><%= formatDate(record.createdAt) %></dd><dt>完成时间</dt><dd><%= formatDate(record.completedAt) %></dd>
</dl></article><% }) %></section>
<section class="panel spaced"><h2>跟进记录</h2>
<% if (!closed) { %><a class="button" href="/animals/<%= animal._id %>/followups/new">添加跟进</a><% } %>
<% if (!followUps.length) { %><p>暂无跟进记录。</p><% } %>
<% followUps.forEach(item => { %><article class="history"><small><%= formatDate(item.createdAt) %> · <%= userName(item.recordedBy) %></small><p><%= item.content %></p>
<% if (item.updatedBy) { %><small>最近修改：<%= userName(item.updatedBy) %> · <%= formatDate(item.updatedAt) %></small><% } %>
<% if (!closed && currentUser && (currentUser.role === 'admin' || String(item.recordedBy?._id || item.recordedBy) === String(currentUser._id))) { %><div class="actions"><a class="text-link" href="/animals/<%= animal._id %>/followups/<%= item._id %>/edit">编辑</a><a class="text-link danger-text" href="/animals/<%= animal._id %>/followups/<%= item._id %>/delete">删除</a></div><% } %>
</article><% }) %></section>
<%- include('footer') %>
