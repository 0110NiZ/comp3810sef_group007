<%- include('header') %>

<% const closed = Boolean(animal.closedAt) || animal.adoptionStatus === 'adopted'; %>

<a class="case-back" href="<%= source.url %>">
    ← Back to <%= source.label === 'List' ? 'Animal Records' : source.label %>
</a>
<% if (rescueNotice) { %>
    <p class="form-feedback" role="status"><%= rescueNotice %></p>
<% } %>
<header class="case-identity">
    <span class="detail-pet"><%- include('pet-avatar', { animal }) %></span>
    <div>
        <div class="case-title-line">
            <h1><%= animal.animalCode %></h1>
            <button type="button" class="copy-code" data-copy="<%= animal.animalCode %>"
                aria-label="Copy animal code" title="Copy animal code">
                <svg viewBox="0 0 20 20" width="20" height="20" fill="none"
                    stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="7" y="2" width="10" height="13" rx="1"/>
                    <path d="M4 6H2v12h10v-1"/>
                </svg>
            </button>
            <span class="badge status-<%= animal.rescueStatus %>">
                <%= labels.rescueStatuses[animal.rescueStatus] %>
            </span>
        </div>
        <p><%= animal.appearance %></p>
        <p class="muted">Updated: <%= formatDate(animal.updatedAt) %></p>
    </div>
</header>
<% if (closed) { %>
    <p class="form-feedback" role="status">
        <%- include('icon', { name: 'lock' }) %>This case is closed. The archived
        record is read-only.</p>
<% } %>

<nav class="case-navigation" aria-label="This animal record">
    <a href="#case-summary">Overview</a>
    <a href="#care-journal">Care Journal <span><%= followUps.length %></span>
    </a>
    <a href="#adoption-history">Adoption History <span><%= adoptionRecords.length %></span>
    </a>
</nav>

<div class="columns" id="case-summary">
    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'paw' }) %>
            </span>
            Animal Information
        </h2>
        <dl>
            <dt>Animal Type</dt>
            <dd> <%= labels.animalTypes[animal.animalType] %> </dd>
            <dt>Appearance</dt>
            <dd> <%= animal.appearance %> </dd>
            <dt>Found Location</dt>
            <dd> <%= animal.foundLocation %> </dd>
            <dt>Health Condition</dt>
            <dd> <%= animal.healthStatus %> </dd>
            <dt>Contact Name</dt>
            <dd> <%= animal.contactName %> </dd>
            <dt>Phone Number</dt>
            <dd> <%= animal.contactPhone %> </dd>
            <dt>Registered</dt>
            <dd><%= formatDate(animal.createdAt) %></dd>
            <dt>Registered By</dt>
            <dd> <%= userName(animal.createdBy) %> </dd>
        </dl>
        <% if (!closed && managesCase(currentUser, animal)) { %>
            <a
                class="case-edit"
                href="/animals/<%= animal._id %>/edit<%= returnQuery('case-summary') %>"
            >Edit Details</a>
        <% } %>
    </section>

    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'care' }) %>
            </span>
            Rescue & Adoption
        </h2>
        <dl class="case-staff">
            <div>
                <dt>Rescue Coordinator</dt>
                <dd><%= unassigned ? 'Unassigned' : userName(animal.assignedTo) %></dd>
            </div>
            <div>
                <dt>Last Updated By</dt>
                <dd><%= animal.updatedBy ? userName(animal.updatedBy) : 'Not recorded' %></dd>
            </div>
        </dl>
        <dl>
            <dt>Rescue Progress</dt>
            <dd>
                <span class="badge status-<%= animal.rescueStatus %>">
                    <%= labels.rescueStatuses[animal.rescueStatus] %>
                </span>
            </dd>
            <dt>Placement Location</dt>
            <dd> <%= animal.placementLocation || 'Not arranged' %> </dd>
            <dt>Adoption Status</dt>
            <dd>
                <span class="badge status-<%= animal.adoptionStatus %>">
                    <%= labels.adoptionStatuses[animal.adoptionStatus] %>
                </span>
            </dd>
            <dt>Case Status</dt>
            <dd> <%= closed ? 'Closed · Archived' : 'Open' %> </dd>
            <% if (animal.closedAt) { %>
                <dt>Closed At</dt>
                <dd> <%= formatDate(animal.closedAt) %> </dd>
                <dt>Closed By</dt>
                <dd> <%= userName(animal.closedBy) %> </dd>
            <% } %>
        </dl>
        <% if (!closed) { %>
            <div class="actions">
                <% if (unassigned) { %>
                    <%- include('take-case', { animal, query: returnQuery('case-summary') }) %>
                <% } %>
                <% if (managesCase(currentUser, animal)) { %>
                    <a class="button primary" href="/animals/<%= animal._id %>/rescue<%= returnQuery('case-summary') %>"><%= unassigned ? 'Assign coordinator' : 'Manage Rescue' %></a>
                    <a class="button" href="/animals/<%= animal._id %>/adoption<%= returnQuery('case-summary') %>">Adoption Management</a>
                <% } else { %>
                    <a class="button" href="/animals/<%= animal._id %>/followups/new<%= returnQuery('care-journal') %>">Add Follow-up</a>
                <% } %>
            </div>
        <% } %>
    </section>
</div>

<section class="panel spaced" id="adoption-history">
    <h2 class="icon-heading">
        <span class="heading-icon"><%- include('icon', { name: 'heart' }) %></span>Adoption History
    </h2>
    <% if (!adoptionRecords.length) { %>
        <p>No adoption registered yet.</p>
    <% } %>
    <% adoptionRecords.forEach(record => { %>
        <article class="history">
            <span
                class="badge <%=
                    record.cancelledAt
                        ? 'status-cancelled'
                        : record.completedAt
                          ? 'status-adopted'
                          : 'status-processing'
                %>"
            > <%=
                record.cancelledAt
                    ? 'Cancelled'
                    : record.completedAt
                      ? 'Completed'
                      : 'In Progress'
            %> </span>
            <dl class="spaced">
                <dt>Adopter</dt>
                <dd> <%= record.adopterName %> </dd>
                <dt>Phone Number</dt>
                <dd> <%= record.adopterPhone %> </dd>
                <dt>Notes</dt>
                <dd> <%= record.remarks || '—' %> </dd>
                <dt>Registered By</dt>
                <dd> <%= userName(record.registeredBy) %> </dd>
                <dt>Registered At</dt>
                <dd> <%= formatDate(record.createdAt) %> </dd>
                <dt>Completed At</dt>
                <dd> <%= formatDate(record.completedAt) %> </dd>
                <% if (record.cancelledAt) { %>
                    <dt>Cancellation Reason</dt>
                    <dd> <%= record.cancellationReason %> </dd>
                    <dt>Cancelled At</dt>
                    <dd> <%= formatDate(record.cancelledAt) %> </dd>
                    <dt>Cancelled By</dt>
                    <dd> <%= userName(record.cancelledBy) %> </dd>
                <% } %>
            </dl>
        </article>
    <% }) %>
</section>

<section class="panel spaced care-journal" id="care-journal">
    <h2 class="icon-heading">
        <span class="heading-icon"><%- include('icon', { name: 'notes' }) %></span>Follow-up Records
    </h2>
    <% if (!closed) { %>
        <a
            class="button"
            href="/animals/<%= animal._id %>/followups/new<%= returnQuery('care-journal') %>"
        >
            <%- include('icon', { name: 'notes-plus' }) %>Add Follow-up</a>
    <% } %>
    <% if (!followUps.length) { %>
        <p>No follow-up records yet.</p>
    <% } %>
    <% followUps.forEach(item => { %>
        <article class="history">
            <small> <%= formatDate(item.createdAt) %> · <%= userName(item.recordedBy) %> </small>
            <p class="care-note"><%= item.content %></p>
            <% if (item.nextFollowUpDate) { %>
                <div class="care-followup-date">
                    <span>Next follow-up:</span>
                    <time datetime="<%= item.nextFollowUpDate %>"><%= item.nextFollowUpDate %></time>
                </div>
            <% } %>
            <% if (item.updatedBy) { %>
                <small>
                    Last edited: <%= userName(item.updatedBy) %> · <%= formatDate(item.updatedAt) %>
                </small>
            <% } %>
            <%
                if (
                    !closed &&
                    currentUser &&
                    (currentUser.role === 'admin' ||
                        String(item.recordedBy?._id || item.recordedBy) ===
                            String(currentUser._id))
                ) {
            %>
                <div class="actions">
                    <a class="text-link"
                        href="/animals/<%= animal._id %>/followups/<%= item._id %>/edit<%=
                            returnQuery('care-journal') %>">
                        <%- include('icon', { name: 'edit' }) %>Edit</a>
                    <% if (currentUser.role === 'admin') { %>
                        <a class="text-link danger-text"
                            href="/animals/<%= animal._id %>/followups/<%= item._id %>/delete<%=
                                returnQuery('care-journal') %>">
                            <%- include('icon', { name: 'delete' }) %>Delete</a>
                    <% } %>
                </div>
            <% } %>
        </article>
    <% }) %>
</section>
<% if (!closed && currentUser?.role === 'admin') { %>
    <div class="panel spaced record-actions" id="record-actions">
        <h2>Record Administration</h2>
        <a class="button delete-record-button"
            href="/animals/<%= animal._id %>/delete<%= returnQuery('record-actions') %>">
            <%- include('icon', { name: 'delete' }) %> Delete Incorrect
            Record </a>
    </div>
<% } %>

<%- include('footer') %>
