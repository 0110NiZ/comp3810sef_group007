<%- include('header') %>
<div class="page-heading"><div><span class="eyebrow">ANIMAL PROFILE</span><h1><%= animal.animalCode %> · 动物详情</h1><p>登记时间：<%= formatDate(animal.createdAt) %></p></div><a class="button" href="/animals">返回列表</a></div>
<div class="columns"><section class="panel"><h2>基本资料</h2><dl><dt>动物类型</dt><dd><%= labels.animalTypes[animal.animalType] %></dd><dt>外观描述</dt><dd><%= animal.appearance %></dd><dt>发现地点</dt><dd><%= animal.foundLocation %></dd><dt>健康状况</dt><dd><%= animal.healthStatus %></dd><dt>联系人</dt><dd><%= animal.contactName %></dd><dt>联系电话</dt><dd><%= animal.contactPhone %>（虚构号码）</dd></dl></section>
<section class="panel"><h2>救助与领养状态</h2><dl><dt>救助进度</dt><dd><span class="badge status-<%= animal.rescueStatus %>"><%= labels.rescueStatuses[animal.rescueStatus] %></span></dd><dt>负责人</dt><dd><%= userName(animal.assignedTo) %></dd><dt>安置地点</dt><dd><%= animal.placementLocation || '待安排' %></dd><dt>领养状态</dt><dd><span class="badge status-<%= animal.adoptionStatus %>"><%= labels.adoptionStatuses[animal.adoptionStatus] %></span></dd><dt>结案状态</dt><dd><%= animal.closedAt ? '已结案 · 保留档案' : '未结案' %></dd><% if (animal.closedAt) { %><dt>结案时间</dt><dd><%= formatDate(animal.closedAt) %></dd><% } %></dl><div class="actions"><a class="button" href="/animals/<%= animal._id %>/rescue">救助管理</a><a class="button" href="/animals/<%= animal._id %>/adoption">领养管理</a></div></section></div>
<% if (adoption) { %><section class="panel spaced"><h2>领养登记</h2><dl><dt>领养人</dt><dd><%= adoption.adopterName %></dd><dt>联系电话</dt><dd><%= adoption.adopterPhone %>（虚构号码）</dd><dt>完成时间</dt><dd><%= formatDate(adoption.completedAt) %></dd></dl></section><% } %>
<section class="panel spaced"><div class="section-heading"><h2>历史跟进记录</h2><a class="button" href="/animals/<%= animal._id %>/followups/new">＋ 添加跟进</a></div><% followUps.forEach(item => { %><article class="history"><small><%= formatDate(item.createdAt) %> · <%= userName(item.recordedBy) %></small><p><%= item.content %></p><div class="actions"><a class="text-link" href="/animals/<%= animal._id %>/followups/<%= item._id %>/edit">编辑</a><a class="text-link danger-text" href="/animals/<%= animal._id %>/followups/<%= item._id %>/delete">删除</a></div></article><% }) %><% if (!followUps.length) { %><p>暂无跟进记录。</p><% } %></section>
<div class="actions"><a class="button" href="/animals/<%= animal._id %>/edit">编辑动物资料</a><a class="button" href="/animals/<%= animal._id %>/delete">删除档案</a></div><%- include('footer') %>
