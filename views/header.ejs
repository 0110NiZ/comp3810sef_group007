<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
        <%= title %> · Pawhaven</title>
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/icons.css">
    <link rel="stylesheet" href="/workspace.css">
    <script src="/app.js" defer>
    </script>
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-mark" aria-hidden="true"><%- include('icon', { name: 'paw' }) %></span>
                <span>Pawhaven<small>RESCUE & ADOPTION</small>
                </span>
            </a>
            <div class="nav-caption">Workspace</div>
            <nav aria-label="Main navigation">
                <% const links = [['home', '/', 'Overview', 'overview'], ['list', '/animals', 'Animal Records', 'paw'], ['create', '/animals/new', 'Add Animal', 'plus']]; %>
                <% links.forEach(([key, href, label, icon]) => { %>
                <a class="nav-item <%= activePage === key ? 'active' : '' %>" href="<%= href %>"
                    <%- activePage === key ? 'aria-current="page"' : '' %>>
                    <span aria-hidden="true">
                        <%- include('icon', { name: icon }) %>
                    </span>
                    <%= label %>
                </a>
                <% }); %>
                <div class="nav-caption">Team & Account</div>
                <% if (currentUser && currentUser.role === 'admin') { %>
                <a class="nav-item <%= activePage === 'users' ? 'active' : '' %>" href="/users"
                    <%- activePage === 'users' ? 'aria-current="page"' : '' %>>
                    <span aria-hidden="true"><%- include('icon', { name: 'team' }) %></span>Team Accounts
                </a>
                <% } %>
                <a class="nav-item <%= activePage === 'profile' ? 'active' : '' %>" href="/profile"
                    <%- activePage === 'profile' ? 'aria-current="page"' : '' %>>
                    <span aria-hidden="true"><%- include('icon', { name: 'user' }) %></span>My Account
                </a>
                <% if (currentUser) { %>
                <form method="POST" action="/logout">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="nav-item sign-out" type="submit">
                        <span aria-hidden="true"><%- include('icon', { name: 'logout' }) %></span>Sign Out
                    </button>
                </form>
                <% } %>
            </nav>
            <div class="sidebar-note">
                <span class="tiny-dot">
                </span>Every record. A new beginning.
            </div>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <div>
                    <span class="eyebrow">PAWHAVEN WORKSPACE</span>
                    <span class="topbar-title">
                        <%= title %>
                    </span>
                </div>
                <% if (currentUser) { %>
                <a href="/profile" class="user-chip">
                    <span class="avatar">
                        <%= (currentUser.displayName || currentUser.username).slice(0, 1).toUpperCase() %>
                    </span>
                    <span>
                        <%= currentUser.displayName %>
                        <small>
                            <%= currentUser.role === 'admin' ? 'Administrator' : 'Staff' %>
                        </small>
                    </span>
                </a>
                <% } %>
            </header>
            <main class="container">
