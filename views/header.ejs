
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#176b52">

    <title><%= title %> · 栖伴</title>

    <link rel="stylesheet" href="/style.css">
    <script src="/preview.js" defer></script>
</head>

<body>
<div class="app-shell">

    <aside class="sidebar">

        <!-- 品牌区域：保持原样 -->
        <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">爪</span>
            <span>
                栖伴
                <small>动物救助与领养管理</small>
            </span>
        </a>

        <div class="nav-caption">工作空间</div>

        <!-- 原有业务导航：不修改其他组员的入口 -->
        <nav aria-label="主导航">

            <a
                class="nav-item <%= activePage === 'home' ? 'active' : '' %>"
                href="/"
                <%- activePage === 'home' ? 'aria-current="page"' : '' %>
            >
                <span aria-hidden="true">◫</span>
                首页统计
            </a>

            <a
                class="nav-item <%= activePage === 'list' ? 'active' : '' %>"
                href="/animals"
                <%- activePage === 'list' ? 'aria-current="page"' : '' %>
            >
                <span aria-hidden="true">▤</span>
                动物档案
            </a>

            <a
                class="nav-item <%= activePage === 'create' ? 'active' : '' %>"
                href="/animals/new"
                <%- activePage === 'create' ? 'aria-current="page"' : '' %>
            >
                <span aria-hidden="true">＋</span>
                新增动物
            </a>

            <div class="nav-caption">账号管理</div>

            <a
                class="nav-item <%= activePage === 'profile' ? 'active' : '' %>"
                href="/profile"
                <%- activePage === 'profile' ? 'aria-current="page"' : '' %>
            >
                <span aria-hidden="true">◎</span>
                个人资料
            </a>

            <!-- T 模块：根据真实登录状态显示登录或退出 -->
            <% if (currentUser) { %>

                <form method="POST" action="/logout">
                    <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>"
                    >

                    <button
                        type="submit"
                        class="nav-item"
                        style="width:100%; border:0; background:transparent; text-align:left; font:inherit; cursor:pointer;"
                    >
                        <span aria-hidden="true">↗</span>
                        退出登录
                    </button>
                </form>

            <% } else { %>

                <a class="nav-item" href="/login">
                    <span aria-hidden="true">↗</span>
                    工作人员登录
                </a>

            <% } %>

        </nav>

        <div class="sidebar-note">
            <span class="tiny-dot"></span>
            每一份记录，都是新的开始。
        </div>

    </aside>

    <div class="workspace">

        <!-- 顶部导航 -->
        <header class="topbar">

            <div>
                <span class="eyebrow">RESCUE & ADOPTION</span>
                <div class="topbar-title">
                    流浪动物救助与领养管理系统
                </div>
            </div>

            <!-- T 模块：显示 MongoDB 中的真实登录用户 -->
            <% if (currentUser) { %>

                <a href="/profile" class="user-chip">

                    <span class="avatar">
                        <%= Array.from(currentUser.displayName || currentUser.username || '?')[0] %>
                    </span>

                    <span>
                        <%= currentUser.displayName || currentUser.username %>

                        <small>
                            <%= currentUser.role === 'admin'
                                ? '管理员'
                                : '工作人员' %>
                        </small>
                    </span>

                </a>

            <% } else { %>

                <a href="/login" class="user-chip">
                    <span class="avatar">?</span>

                    <span>
                        未登录
                        <small>点击登录</small>
                    </span>
                </a>

            <% } %>

        </header>

        <main class="container">

            <!-- 账号页面显示真实状态，其他业务原型保留原提示 -->
            <div class="preview-strip">
                <span class="tiny-dot"></span>

                <% if (currentUser && activePage === 'profile') { %>
                    账号信息已连接 MongoDB · 修改将保存
                <% } else { %>
                    示例数据 · 表单仅预览，不保存
                <% } %>

                <div class="strip-end">
                    让救助有迹可循
                </div>
            </div>
