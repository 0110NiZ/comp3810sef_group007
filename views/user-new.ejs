<%- include('header') %>
<div class="page-heading">
    <div>
        <span class="eyebrow">TEAM ADMINISTRATION</span>
        <h1>Create Staff Account</h1>
        <p>Assign an individual account for daily rescue work.</p>
    </div>
    <a class="button" href="/users">Back to Team</a>
</div>
<section class="panel form-panel">
    <% if (error) { %>
    <p class="warning-box" role="alert">
        <%= error %>
    </p>
    <% } %>
    <form method="POST" action="/users/new">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-grid">
            <label>Username <em>*</em>
                <input name="username" required minlength="3" maxlength="40" pattern="[a-zA-Z0-9_-]{3,40}"
                    value="<%= values.username || '' %>" autocomplete="off">
            </label>
            <label>Display Name <em>*</em>
                <input name="displayName" required maxlength="80" value="<%= values.displayName || '' %>">
            </label>
            <label>Phone Number
                <input type="tel" name="phone" maxlength="30" value="<%= values.phone || '' %>">
            </label>
            <label>Initial Password <em>*</em>
                <input type="password" name="password" required minlength="8" maxlength="128"
                    autocomplete="new-password">
            </label>
        </div>
        <div class="form-bottom">
            <p>Role: Staff. The account holder can change their password after signing in.</p>
            <button class="primary" type="submit">Create Account</button>
        </div>
    </form>
</section>
<%- include('footer') %>
