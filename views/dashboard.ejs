<%- include('header') %>

<section class="welcome-banner">
    <div>
        <span class="eyebrow">CARE STARTS HERE</span>

        <h1>
            给每一个小生命，<br>
            一个新的开始。
        </h1>

        <p>从发现、救助到找到新家，在这里记录每一步。</p>

        <div class="actions">
            <a class="button primary" href="/animals/new">
                ＋ 登记新动物
            </a>
            <a class="text-link" href="/animals">
                查看全部档案 ↗
            </a>
        </div>
    </div>

    <div class="journey-art" aria-hidden="true">
        <span class="art-orbit"></span>
        <div class="art-animal">🐈</div>
        <span class="art-tag tag-one">♡ 用心救助</span>
        <span class="art-tag tag-two">⌂ 温暖归宿</span>
    </div>
</section>

<% if (typeof yPreview !== 'undefined' && yPreview) { %>
<section class="panel" style="margin-top: 20px;">
    <p class="muted">
        开发预览模式：当前统计来自示例动物数据，尚未连接 MongoDB。
    </p>
</section>
<% } %>

<div class="section-heading dashboard-heading">
    <div>
        <span class="eyebrow">OVERVIEW</span>
        <h2>救助概览</h2>
    </div>

    <span class="muted">全部动物档案</span>
</div>

<div class="metrics">
    <section class="metric">
        <span class="metric-icon" aria-hidden="true">▤</span>
        <span>动物档案总数</span>

        <strong class="number">
            <%= total %>
            <small>只</small>
        </strong>

        <p>每份档案，记录一个生命</p>
    </section>

    <% rescueCounts.forEach((item, i) => { %>
        <section class="metric metric-<%= i %>">
            <span class="metric-icon" aria-hidden="true">
                <%= ['◷', '♡', '⌂'][i] || '♡' %>
            </span>

            <span><%= item.label %></span>

            <strong class="number">
                <%= item.count %>
                <small>只</small>
            </strong>

            <p>
                <%= [
                    '等待救助人员跟进',
                    '持续关注治疗与恢复',
                    '已安排安置地点'
                ][i] || '动物救助状态统计' %>
            </p>
        </section>
    <% }) %>
</div>

<div class="columns">
    <section class="panel">
        <div class="section-heading">
            <h2>最近更新</h2>
            <a href="/animals">全部档案 ↗</a>
        </div>

        <% if (animals.length > 0) { %>
            <% animals.forEach(animal => { %>
                <div class="record-row">
                    <span class="animal-avatar" aria-hidden="true">
                        <%= animal.animalType === 'cat' ? '🐈' :
                            animal.animalType === 'dog' ? '🐕' : '🐾' %>
                    </span>

                    <div class="record-copy">
                        <strong><%= animal.animalCode %></strong>

                        <p><%= animal.appearance %></p>

                        <small>
                            <%= animal.foundLocation %>
                            ·
                            <%= animal.updatedAt ? formatDate(animal.updatedAt) : '—' %>
                        </small>
                    </div>

                    <span class="badge status-<%= animal.rescueStatus %>">
                        <%= labels.rescueStatuses[animal.rescueStatus] || '未知' %>
                    </span>

                    <a
                        class="arrow-link"
                        href="/animals/<%= animal._id %>"
                        aria-label="查看 <%= animal.animalCode %> 详情"
                    >
                        ↗
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <p class="empty">
                暂无动物档案，登记新动物后将在这里显示。
            </p>
        <% } %>
    </section>

    <section class="panel">
        <span class="eyebrow">A NEW HOME</span>
        <h2>领养进展</h2>

        <% adoptionCounts.forEach((item, i) => { %>
            <div class="adoption-row">
                <div>
                    <span>
                        <i class="legend-dot legend-<%= i %>"></i>
                        <%= item.label %>
                    </span>

                    <strong><%= item.count %></strong>
                </div>

                <div class="progress-track">
                    <span
                        class="progress-fill fill-<%= i %>"
                        style="width: <%= total ? item.count / total * 100 : 0 %>%"
                    ></span>
                </div>
            </div>
        <% }) %>

        <p class="panel-note">
            已领养动物继续保留完整档案。
        </p>
    </section>
</div>

<%- include('footer') %>
