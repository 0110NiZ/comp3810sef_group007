<%- include('header') %>

<div class="panel dashboard-title-row">
    <h1 class="dashboard-title">Dashboard</h1>
    <img class="dashboard-illustration" src="/assets/landscape.svg" alt="">
    <a class="button primary dashboard-register" href="/animals/new">
        <%- include('icon', { name: 'plus' }) %> Register Animal
    </a>
</div>

<div class="section-heading dashboard-heading">
    <div>
        <h2>Rescue Overview</h2>
    </div>
</div>

<div class="metrics">
    <section class="metric">
        <span class="metric-icon" aria-hidden="true"><%- include('icon', { name: 'paw' }) %></span>
        <span>Total Animals</span>
        <strong class="number"> <%= total %> </strong>
    </section>
    <% rescueCounts.forEach((item, i) => { %>
        <section class="metric metric-<%= i %>">
            <span class="metric-icon" aria-hidden="true">
                <%- include('icon', { name: ['clock', 'care', 'home'][i] || 'paw' }) %>
            </span>
            <span> <%= item.label %> </span>
            <strong class="number"> <%= item.count %> </strong>
        </section>
    <% }) %>
</div>

<section class="panel followup-agenda spaced">
    <h2 class="icon-heading"><%- include('icon', { name: 'notes' }) %>Follow-ups Due</h2>
    <% if (!dueFollowUps.length) { %>
        <p>No follow-ups due today or overdue.</p>
    <% } %>
    <% dueFollowUps.forEach(entry => { %>
        <div class="agenda-entry" id="due-<%= entry._id %>">
            <strong><%= entry.animalCode %></strong>
            <span><%= entry.due === today ? 'Due today' : 'Overdue' %> · <%= entry.due %></span>
            <a
                class="button"
                href="/animals/<%= entry._id %>/followups/new<%= returnQuery('due-' + entry._id) %>"
            >Add
                Follow-up</a>
        </div>
    <% }) %>
</section>

<section class="panel dashboard-recent">
    <div class="section-heading">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'clock' }) %>
            </span>
            Recently Updated
        </h2>
        <a class="recent-link" href="/animals">
            All Records <%- include('icon', { name: 'arrow' }) %>
        </a>
    </div>
    <% if (animals.length > 0) { %>
        <% animals.forEach(animal => { %>
            <div class="recent-entry" id="record-<%= animal._id %>">
                <span class="animal-avatar animal-avatar-<%= animal.animalType %>"
                    aria-hidden="true"> <%- include('pet-avatar', { animal }) %> </span>
                <strong class="recent-code"><%= animal.animalCode %></strong>
                <div class="recent-description">
                    <p> <%= animal.appearance %> </p>
                    <small>
                        <%= animal.foundLocation %> · <%= animal.updatedAt ? formatDate(animal.updatedAt) : '—' %>
                    </small>
                </div>
                <div class="recent-badges">
                    <span class="badge status-<%= animal.rescueStatus %>">
                        <%= labels.rescueStatuses[animal.rescueStatus] || 'Unknown' %>
                    </span>
                    <span class="badge status-<%= animal.adoptionStatus %>"> <%=
                        labels.adoptionStatuses[animal.adoptionStatus] || 'Unknown'
                    %> </span>
                </div>
                <a class="recent-link"
                    href="/animals/<%= animal._id %><%= returnQuery('record-' + animal._id) %>"
                    aria-label="View <%= animal.animalCode %> Details">
                    View Details <%- include('icon', { name: 'arrow' }) %>
                </a>
            </div>
        <% }) %>
    <% } else { %>
        <p class="empty"> No animal records yet. Register the first animal to get
            started. </p>
    <% } %>
</section>

<div class="pixel-chart-grid">
    <%- include('rescue-chart', { rescueCounts }) %>
    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'heart' }) %>
            </span>
            Adoption Progress
        </h2>
        <% adoptionCounts.forEach((item, i) => { %>
            <div class="adoption-row">
                <div>
                    <span>
                        <i class="legend-dot legend-<%= i %>">
                        </i> <%= item.label %>
                    </span>
                    <strong> <%= item.count %> </strong>
                </div>
                <div class="progress-track">
                    <span class="progress-fill fill-<%= i %>"
                        style="width: <%= total ? item.count / total * 100 : 0 %>%">
                    </span>
                </div>
            </div>
        <% }) %>
    </section>
</div>

<%- include('footer') %>
