<div class="form-grid"><label>动物类型 <em>*</em><select name="animalType" required><option value="">请选择类型</option><% Object.entries(labels.animalTypes).forEach(([value,label]) => { %><option value="<%= value %>" <%= animal.animalType === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label><label>发现地点 <em>*</em><input name="foundLocation" value="<%= animal.foundLocation || '' %>" placeholder="例如：校园东门" required maxlength="200"></label><label class="full">外观描述 <em>*</em><textarea name="appearance" rows="3" placeholder="毛色、体型和明显特征，方便工作人员辨认" required maxlength="1000"><%= animal.appearance || '' %></textarea></label><label class="full">健康状况 <em>*</em><textarea name="healthStatus" rows="3" placeholder="记录观察到的情况，未检查可填写“待检查”" required maxlength="1000"><%= animal.healthStatus || '' %></textarea></label><label>联系人 <em>*</em><input name="contactName" value="<%= animal.contactName || '' %>" placeholder="发现人或联络人姓名" required maxlength="80"></label><label>联系电话 <em>*</em><input name="contactPhone" type="tel" value="<%= animal.contactPhone || '' %>" placeholder="填写可联系的电话号码" required maxlength="30"></label></div>
