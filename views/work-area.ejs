<%- include('header') %>

<div class="pixel-work-area area-<%= area.key %>">
    <div class="page-heading">
        <div>
            <h1 class="pixel-page-title"><%-
                include('icon', {
                    name:
                        area.key === 'adoption'
                            ? 'heart'
                            : area.key === 'rescue'
                              ? 'care'
                              : 'notes'
                })
            %><%= area.title %></h1>
        </div>
        <% if (area.key === 'followups' && tab !== 'new') { %>
            <a class="button primary" href="<%= urlFor('new') %>">＋ Add Follow-up</a>
        <% } %>
    </div>
    <nav class="work-tabs" aria-label="Workspace categories">
        <% area.tabs.filter(([key]) =>
            area.key !== 'followups' || key !== 'new' || tab === 'new'
        ).forEach(([key, label]) => { %>
            <a
                class="button <%= tab === key ? 'primary' : '' %>"
                href="<%= urlFor(key) %>"
                <%- tab === key ? 'aria-current="page"' : '' %>
            ><%= label %></a>
        <% }) %>
    </nav>

    <form class="panel work-search" method="get" action="<%= basePath %>">
        <input type="hidden" name="tab" value="<%= tab %>">
        <% if (assignedToMe) { %>
            <input type="hidden" name="assignedTo" value="me">
        <% } %>
        <label>Find an Animal
            <input name="q" maxlength="100" value="<%= q %>"
                placeholder="Animal code or description">
        </label>
        <button class="primary" type="submit">
            <%- include('icon', { name: 'search' }) %>Search
        </button>
        <a class="button" href="<%= basePath %>?tab=<%= tab %>">
            <%- include('icon', { name: 'refresh' }) %>Reset
        </a>
        <span class="muted"><%= total %> <%= animalRows ? 'animals' : 'records' %></span>
    </form>
    <% if (!rows.length) { %>
        <section class="panel work-empty <%= area.key === 'adoption' && tab === 'available' ? 'adoption-empty' : '' %>">
            <% if (area.key === 'adoption' && tab === 'available') { %>
                <div class="adoption-empty-art" aria-hidden="true">
                    <span class="adoption-empty-heart"><%- include('icon', { name: 'heart' }) %></span>
                    <img src="/assets/companions.svg" alt="">
                </div>
            <% } %>
            <span class="heading-icon"><%-
                include('icon', {
                    name:
                        area.key === 'followups'
                            ? 'notes'
                            : area.key === 'rescue'
                              ? 'care'
                              : 'heart'
                })
            %></span>
            <h2><%=
                q
                    ? 'No matching records'
                    : area.key === 'rescue' && tab !== 'archived'
                      ? 'No active cases in this category'
                      : area.key === 'adoption' && tab === 'available'
                        ? 'No animals are available for adoption'
                        : 'Nothing here yet'
            %></h2>
            <p><%=
                q
                    ? 'Try another animal code or description.'
                    : area.key === 'adoption' && tab === 'available'
                        ? 'Animals appear here after placement and health confirmation.'
                        : 'Records will appear here when they reach this stage.'
            %></p>
            <% if (area.key === 'rescue') { %>
                <a class="button" href="<%= urlFor('archived') %>">View Archived Cases</a>
                <a class="button" href="/animals">Browse Animal Records</a>
            <% } else if (area.key === 'adoption' && tab === 'available') { %>
                <a class="button" href="<%= urlFor('not_open') %>">
                    <%- include('icon', { name: 'care' }) %>View not-open cases
                </a>
            <% } else { %>
                <a class="button" href="/animals">Browse Animal Records</a>
            <% } %>
        </section>
    <% } else if (area.key === 'rescue') { %>
        <%- include('rescue-list') %>
    <% } else { %>
    <div class="work-records <%= area.key === 'followups' && !animalRows ? 'journal-feed' : '' %>">
        <%
            rows.forEach((row) => {
                const animal = animalRows ? row : row.animalId;
                if (!animal) return;
                const closed =
                    Boolean(animal.closedAt) ||
                    animal.adoptionStatus === 'adopted';
                const applicationStatus =
                    !animalRows && area.key === 'adoption'
                        ? row.cancelledAt
                            ? 'cancelled'
                            : row.completedAt
                              ? 'adopted'
                              : 'processing'
                        : null;
                const canEdit =
                    !closed &&
                    (currentUser.role === 'admin' ||
                        String(row.recordedBy?._id || row.recordedBy) ===
                            String(currentUser._id));
                const recordType = area.key === 'followups' && !animalRows ? 'followup-entry' : '';
        %>
            <article
                id="record-<%= row._id %>"
                class="panel work-record <%= closed ? 'archived-record' : '' %> <%= recordType %>"
            >
                <% if (workNotice?.id === String(row._id)) { %>
                    <p class="form-feedback" role="status"><%= workNotice.message %></p>
                <% } %>
                <header class="work-record-heading">
                    <span class="work-animal-icon"><%- include('pet-avatar', { animal }) %></span>
                    <div>
                        <% if (recordType === 'followup-entry') { %>
                            <h2><%= animal.animalCode %></h2>
                            <p class="journal-meta">
                                <%- include('icon', { name: 'user' }) %>
                                <%= row.recordedBy?.displayName || 'Account unavailable' %>
                                · <%= formatDate(row.createdAt) %>
                            </p>
                        <% } else { %>
                        <span class="eyebrow"><%= animal.animalCode %></span>
                        <% if (closed) { %>
                            <span class="archive-label">
                                <%- include('icon', { name: 'lock' }) %>Read-only
                            </span>
                        <% } %>
                        <h2><%= animal.appearance %></h2>
                        <% } %>
                    </div>
                    <span
                        class="badge status-<%=
                            applicationStatus ||
                                (area.key === 'adoption'
                                    ? animal.adoptionStatus
                                    : animal.rescueStatus)
                        %>"
                    > <%=
                        applicationStatus
                            ? applicationStatus === 'cancelled'
                                ? 'Cancelled'
                                : applicationStatus === 'adopted'
                                  ? 'Completed · Read-only'
                                  : 'In Progress'
                            : closed
                              ? 'Archived · Read-only'
                              : area.key === 'adoption'
                                ? labels.adoptionStatuses[animal.adoptionStatus]
                                : labels.rescueStatuses[animal.rescueStatus]
                    %> </span>
                </header>
                <% if (area.key === 'followups' && !animalRows) { %>
                    <p class="journal-content"><%= row.content %></p>
                    <% if (row.nextFollowUpDate) { %>
                        <p>
                            Next follow-up ·
                            <time datetime="<%= row.nextFollowUpDate %>">
                            <%= row.nextFollowUpDate %>
                            </time>
                        </p>
                    <% } %>
                    <% if (String(row.updatedAt) !== String(row.createdAt)) { %>
                        <small class="muted">Last edited <%= formatDate(row.updatedAt) %></small>
                    <% } %>
                <% } else if (area.key === 'adoption' && !animalRows) { %>
                    <dl class="work-facts">
                        <dt>Adopter</dt>
                        <dd><%= row.adopterName %></dd>
                        <dt>Phone</dt>
                        <dd><%= row.adopterPhone %></dd>
                        <dt>Application</dt>
                        <dd><%=
                            tab === 'cancelled'
                                    ? 'Cancelled'
                                    : tab === 'completed'
                                      ? 'Completed'
                                      : 'In Progress'
                        %></dd>
                        <dt>Registered</dt>
                        <dd><%= formatDate(row.createdAt) %></dd>
                        <% if (row.cancelledAt) { %>
                            <dt>Cancellation Reason</dt>
                            <dd><%= row.cancellationReason %></dd>
                        <% } %>
                    </dl>
                <% } else { %>
                    <p><%= animal.healthStatus %></p>
                    <p class="muted">
                        Placement: <%= animal.placementLocation || 'Not arranged' %>
                    </p>
                <% } %>
                <footer class="actions work-record-actions">
                    <% if (area.key === 'followups' && animalRows && !closed) { %>
                        <a class="button primary"
                            href="/animals/<%= animal._id %>/followups/new<%=
                                returnQuery('record-' + row._id) %>">
                            <%- include('icon', { name: 'notes-plus' }) %>Add Follow-up</a>
                    <% } else if (area.key === 'followups' && !animalRows && canEdit) { %>
                        <a class="button"
                            href="/animals/<%= animal._id %>/followups/<%= row._id %>/edit<%=
                                returnQuery('record-' + row._id) %>">
                            <%- include('icon', { name: 'edit' }) %>Edit Entry</a>
                        <% if (currentUser.role === 'admin') { %>
                            <a class="button danger-text"
                                href="/animals/<%= animal._id %>/followups/<%= row._id %>/delete<%=
                                    returnQuery('record-' + row._id) %>">
                                <%- include('icon', { name: 'delete' }) %>Delete Entry</a>
                        <% } %>
                    <% } else if (area.key === 'adoption' && !closed && managesCase(currentUser, animal) && !['cancelled', 'completed'].includes(tab)) { %>
                        <a class="button primary"
                            href="/animals/<%= animal._id %>/adoption<%=
                                returnQuery('record-' + row._id) %>"><%=
                                tab === 'processing'
                                        ? 'Continue Application'
                                        : tab === 'available'
                                          ? 'Register Adopter'
                                          : 'Review Availability'
                            %>
                        </a>
                    <% } %>
                    <a class="text-link"
                        href="/animals/<%= animal._id %><%= returnQuery('record-' + row._id) %><%=
                            area.key === 'followups'
                                    ? '#care-journal'
                                    : area.key === 'adoption'
                                      ? '#adoption-history'
                                      : ''
                        %>">View Animal
                        Record</a>
                </footer>
            </article>
        <% }) %>
    </div>
    <% } %>
    <nav class="pagination" aria-label="Workspace pages">
        <span>Page <%= page %> of <%= pageCount %> · 10 per page</span>
        <div>
            <% if (page > 1) { %>
                <a class="button" href="<%= urlFor(tab, page - 1) %>">Previous</a>
            <% } %>
            <% if (page < pageCount) { %>
                <a class="button" href="<%= urlFor(tab, page + 1) %>">Next</a>
            <% } %>
        </div>
    </nav>
</div>

<%- include('footer') %>
