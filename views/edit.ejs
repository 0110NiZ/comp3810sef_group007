<%- include('header') %>
<div class="page-heading">
    <div>
        <span class="eyebrow">EDIT RECORD</span>
        <h1>Edit Animal</h1>
        <p>
            <%= animal.animalCode %> · Update details and contact information</p>
    </div>
    <a class="button" href="/animals/<%= animal._id %>">Back to Details</a>
</div>
<section class="panel form-panel">
    <h2 class="icon-heading">
        <span class="heading-icon"><%- include('icon', { name: 'paw' }) %></span>Basic Information
    </h2>
    <% if (error) { %>
    <p class="form-feedback" role="alert">
        <%= error %>
    </p>
    <% } %>
    <form method="POST" action="/animals/<%= animal._id %>/edit">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="expectedUpdatedAt"
            value="<%= typeof expectedUpdatedAt === 'string' ? expectedUpdatedAt : '' %>">
        <%- include('animal-fields', { animal }) %>
        <div class="form-actions actions">
            <a class="button" href="/animals/<%= animal._id %>">Cancel</a>
            <button class="primary" type="submit">Save Changes</button>
        </div>
    </form>
</section>
<%- include('footer') %>
