<%- include('header') %>
<div class="page-heading"><div><span class="eyebrow">EDIT RECORD</span><h1>编辑动物资料</h1><p><%= animal.animalCode %> · 更新基本资料与联系信息</p></div><a class="button" href="/animals/<%= animal._id %>">返回详情</a></div>
<section class="panel form-panel"><h2>基本资料</h2>
<% if (error) { %><p class="form-feedback" role="alert"><%= error %></p><% } %>
<form method="POST" action="/animals/<%= animal._id %>/edit">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="expectedUpdatedAt" value="<%= typeof expectedUpdatedAt === 'string' ? expectedUpdatedAt : '' %>">
<%- include('animal-fields', { animal }) %>
<div class="form-actions actions"><a class="button" href="/animals/<%= animal._id %>">取消</a><button class="primary" type="submit">保存修改</button></div>
</form></section>
<%- include('footer') %>
