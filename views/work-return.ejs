<% if (backSource || workReturn) { %>
    <div class="work-return">
        <a class="text-link" href="<%= backSource?.url || workReturn %>">← Back to <%=
            backSource
                ? backSource.label
                : workAreaKey === 'rescue'
                  ? 'Rescue Management'
                  : workAreaKey === 'followups'
                    ? 'Follow-up Records'
                    : 'Adoption Management'
        %></a>
    </div>
<% } %>
