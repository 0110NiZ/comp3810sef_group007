<%- include('header') %><div class="page-heading"><div><span class="eyebrow">CARE JOURNAL</span><h1><%= title %></h1><p><%= animal.animalCode %> · <%= animal.appearance %></p></div><a class="button" href="/animals/<%= animal._id %>">返回详情</a></div><section class="panel form-panel"><% if (mode === 'delete') { %><div class="warning-box"><h2>确认要删除这条跟进记录？</h2><p>正式接入后，只有记录作者或管理员可以执行删除。</p></div><blockquote><%= followUp.content %></blockquote><form method="dialog" data-preview="删除跟进记录"><label class="checkbox"><input type="checkbox" required>我已核对这条记录</label><%- include('form-actions', { cancelUrl: '/animals/' + animal._id, submitLabel: '预览删除确认' }) %></form><% } else { %><h2>记录本次跟进</h2><form method="dialog" data-preview="跟进记录"><label>跟进内容 <em>*</em><textarea name="content" rows="7" required maxlength="2000" placeholder="记录治疗、照护和现场观察等情况"><%= followUp ? followUp.content : '' %></textarea></label><%- include('form-actions', { cancelUrl: '/animals/' + animal._id, submitLabel: '预览跟进内容' }) %></form><% } %></section><%- include('footer') %>
