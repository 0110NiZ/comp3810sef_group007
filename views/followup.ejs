<%- include('header') %>

<% if (!backSource) { %> <%- include('work-return') %> <% } %>
<%
    const hasError = typeof error === 'string' && error;
    const isStale = typeof stale !== 'undefined' && stale;
    const noteValue =
        typeof draftContent === 'string'
            ? draftContent
            : followUp
              ? followUp.content
              : '';
    const versionValue =
        typeof expectedUpdatedAt === 'string'
            ? expectedUpdatedAt
            : followUp
              ? followUp.updatedAt.toISOString()
              : '';
%>

<div class="page-heading">
    <div>
        <h1 class="pixel-page-title"><%-
            include('icon', {
                name:
                    mode === 'delete'
                        ? 'warning'
                        : mode === 'edit'
                          ? 'edit'
                          : 'notes-plus'
            })
        %> <%= title %> </h1>
        <p> <%= animal.animalCode %> · <%= animal.appearance %> </p>
    </div>
    <a class="button" href="<%= backSource?.url || '/animals/' + animal._id %>">
        Back to <%= backSource?.label || 'Details' %>
    </a>
</div>

<section class="panel form-panel">
    <% if (hasError) { %>
        <div class="warning-box" role="alert">
            <strong>Your changes have not been saved.</strong>
            <p><%= error %></p>
            <% if (isStale) { %>
                <p>Copy your notes before reloading, then compare them with the latest
                    record.</p>
                <a class="button"
                    href="/animals/<%= animal._id %>/followups/<%=
                        mode === 'create' ? 'new' : followUp._id + '/' + mode %><%=
                        carryReturn
                    %>">
                    Reload
                    and Review</a>
            <% } %>
        </div>
    <% } %>
    <% if (mode === 'delete') { %>
        <div class="warning-box">
            <h2>Delete this follow-up?</h2>
            <p>Only the author or an administrator can delete this entry.</p>
        </div>
        <blockquote> <%= followUp.content %> </blockquote>
        <form method="POST"
            action="/animals/<%= animal._id %>/followups/<%= followUp._id %>/delete<%= carryReturn %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="expectedUpdatedAt" value="<%= versionValue %>">
            <label class="checkbox">
                <input type="checkbox" required> I have reviewed this entry
            </label>
            <div class="form-bottom">
                <p>This entry cannot be restored after deletion.</p>
                <div class="actions">
                    <a
                        class="button"
                        href="<%= backSource?.url || '/animals/' + animal._id %>"
                    ><%- include('icon', { name: 'back' }) %> Cancel </a>
                    <button class="danger" type="submit" <%= isStale ? 'disabled' : '' %>>
                        <%- include('icon', { name: 'delete' }) %>Confirm
                        Deletion </button>
                </div>
            </div>
        </form>
    <% } else { %>
        <h2> <%= mode === 'create' ? 'New Follow-up' : 'Edit Follow-up' %> </h2>
        <form method="POST"
            action="/animals/<%= animal._id %>/followups/<%=
                mode === 'create' ? 'new' : followUp._id + '/edit' %><%=
                carryReturn
            %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (followUp) { %>
                <input type="hidden" name="expectedUpdatedAt" value="<%= versionValue %>">
            <% } %>
            <label> Notes <em>*</em>
                <textarea name="content" rows="7" required maxlength="2000"
                    aria-describedby="notes-hint"
                    placeholder="Record treatment, care and observations"><%= noteValue %></textarea>
                <small class="field-hint" id="notes-hint">Required · Up to 2,000
                    characters. Include observations, care given and next steps.</small>
            </label>
            <div class="spaced y-date-range-field followup-date">
                <label for="y-date-from">Next Follow-up Date (optional)</label>
                <input type="date" id="y-date-from" name="nextFollowUpDate"
                    value="<%= typeof draftNextDate === 'string' ? draftNextDate : followUp?.nextFollowUpDate || '' %>">
                <button type="button" id="y-range-trigger" class="y-range-trigger" hidden
                    aria-expanded="false" aria-controls="y-range-calendar">Select date</button>
                <%- include('calendar-panel', { single: true }) %>
            </div>
            <div class="form-bottom">
                <div class="actions">
                    <a
                        class="button"
                        href="<%= backSource?.url || '/animals/' + animal._id %>"
                    ><%- include('icon', { name: 'back' }) %> Cancel </a>
                    <button class="primary" type="submit" <%= isStale ? 'disabled' : '' %>>
                        <%= mode === 'create' ? 'Save Follow-up' : 'Save Changes' %>
                    </button>
                </div>
            </div>
        </form>
    <% } %>
</section>

<% if (mode !== 'delete') { %>
    <link rel="stylesheet" href="/date_range.css">
    <script src="/date_range.js" defer></script>
<% } %>
<%- include('footer') %>
