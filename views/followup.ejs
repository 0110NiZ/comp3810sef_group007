
<%- include('header') %>

<div class="page-heading">
    <div>
        <span class="eyebrow">CARE JOURNAL</span>
        <h1><%= title %></h1>
        <p><%= animal.animalCode %> · <%= animal.appearance %></p>
    </div>

    <a class="button" href="/animals/<%= animal._id %>">
        返回详情
    </a>
</div>

<section class="panel form-panel">
    <% if (mode === 'delete') { %>

        <div class="warning-box">
            <h2>确认要删除这条跟进记录？</h2>
            <p>只有记录作者或管理员可以执行删除。</p>
        </div>

        <blockquote><%= followUp.content %></blockquote>

        <form
            method="POST"
            action="/animals/<%= animal._id %>/followups/<%= followUp._id %>/delete"
        >
            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
            >

            <label class="checkbox">
                <input type="checkbox" required>
                我已核对这条记录
            </label>

            <div class="form-bottom">
                <p>删除后将无法在当前页面恢复该记录。</p>

                <div class="actions">
                    <a class="button" href="/animals/<%= animal._id %>">
                        取消
                    </a>

                    <button class="primary" type="submit">
                        确认删除
                    </button>
                </div>
            </div>
        </form>

    <% } else { %>

        <h2>
            <%= mode === 'create' ? '记录本次跟进' : '修改跟进内容' %>
        </h2>

        <form
            method="POST"
            action="/animals/<%= animal._id %>/followups/<%= mode === 'create' ? 'new' : followUp._id + '/edit' %>"
        >
            <input
                type="hidden"
                name="_csrf"
                value="<%= csrfToken %>"
            >

            <label>
                跟进内容 <em>*</em>

                <textarea
                    name="content"
                    rows="7"
                    required
                    maxlength="2000"
                    placeholder="记录治疗、照护和现场观察等情况"
                ><%= followUp ? followUp.content : '' %></textarea>
            </label>

            <div class="form-bottom">
                <p>记录将保存到 MongoDB，便于后续查看。</p>

                <div class="actions">
                    <a class="button" href="/animals/<%= animal._id %>">
                        取消
                    </a>

                    <button class="primary" type="submit">
                        <%= mode === 'create' ? '保存跟进记录' : '保存修改' %>
                    </button>
                </div>
            </div>
        </form>

    <% } %>
</section>

<%- include('footer') %>
