<%- include('header') %>

<% if (!backSource) { %> <%- include('work-return') %> <% } %>

<div class="page-heading">
    <div>
        <h1 class="pixel-page-title"><%- include('icon', { name: 'care' }) %>Rescue Management</h1>
        <p> <%= animal.animalCode %> · <%= animal.appearance %> </p>
    </div>
    <a class="button" href="<%= backSource?.url || '/animals/' + animal._id %>">
        Back to <%= backSource?.label || 'Details' %>
    </a>
</div>
<% const closed = Boolean(animal.closedAt) || animal.adoptionStatus === 'adopted'; %>
<% const coordinator = users.find(user => String(user._id) === String(animal.assignedTo));
   const canManage = !closed && managesCase(currentUser, animal); %>
<% if (error) { %>
    <p class="warning-box" role="alert"> <%= error %> </p>
<% } %>
<% if (stale) { %>
    <a class="button spaced" href="/animals/<%= animal._id %>/rescue<%= carryReturn %>">Reload and
        Review</a>
<% } %>
<% if (closed) { %>
    <p class="form-feedback">This case is closed. The record is read-only.</p>
<% } %>

<div class="rescue-workspace">
    <section class="panel">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'home' }) %>
            </span>
            Assignment & Placement
        </h2>
        <p>Rescue coordinator: <strong><%= coordinator?.displayName || (animal.assignedTo ? 'Unknown account' : 'Unassigned') %></strong></p>
        <% if (!closed && !animal.assignedTo && !stale) { %>
            <%- include('take-case', { animal, query: carryReturn }) %>
        <% } %>
        <% if (canManage) { %>
        <form method="POST" action="/animals/<%= animal._id %>/rescue<%= carryReturn %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="expectedUpdatedAt" value="<%= expectedUpdatedAt %>">
            <fieldset <%= closed || stale ? 'disabled' : '' %>>
                <div class="form-grid">
                    <label> Rescue Progress <em aria-hidden="true">*</em>
                        <select name="rescueStatus" required>
                            <%
                                Object.entries(labels.rescueStatuses).forEach(
                                    ([value, label]) => {
                            %>
                                <option
                                    value="<%= value %>"
                                    <%=
                                        animal.rescueStatus === value ? 'selected' : ''
                                    %>
                                > <%= label %>
                                </option>
                            <% }) %>
                        </select>
                    </label>
                    <label class="full"> Placement Location <em
                            data-required-mark="placementLocation" aria-hidden="true"
                            <%= animal.rescueStatus === 'placed' ? '' : 'hidden' %>>*</em>
                        <input name="placementLocation" value="<%= animal.placementLocation || '' %>"
                            placeholder="Clinic, shelter or temporary placement"
                            maxlength="200"
                            <%= animal.rescueStatus === 'placed' ? 'required' : '' %>>
                    </label>
                </div>
                <div class="form-bottom">
                    <div class="actions">
                        <a
                            class="button"
                            href="<%= backSource?.url || '/animals/' + animal._id %>"
                        ><%- include('icon', { name: 'back' }) %> Cancel </a>
                        <button class="primary" type="submit"> Save Rescue Changes
                        </button>
                    </div>
                </div>
            </fieldset>
        </form>
        <% } else { %>
            <dl>
                <dt>Rescue Progress</dt><dd><%= labels.rescueStatuses[animal.rescueStatus] %></dd>
                <dt>Placement Location</dt><dd><%= animal.placementLocation || 'Not arranged' %></dd>
            </dl>
        <% } %>
    </section>
    <% if (!closed) { %>
        <% if (currentUser.role === 'admin' && !stale) { %>
            <section class="panel">
                <h2><%= animal.assignedTo ? 'Hand over case' : 'Assign coordinator' %></h2>
                <form class="coordinator-form" method="post" action="/animals/<%= animal._id %>/assign<%= carryReturn %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="expectedUpdatedAt" value="<%= expectedUpdatedAt %>">
                    <label>New rescue coordinator
                        <select name="assignedTo" required>
                            <option value="">Select a coordinator</option>
                            <% users.filter(user => user.isActive !== false && String(user._id) !== String(animal.assignedTo)).forEach(user => { %>
                                <option value="<%= user._id %>"><%= user.displayName %></option>
                            <% }) %>
                        </select>
                    </label>
                    <button class="primary" type="submit"><%= animal.assignedTo ? 'Hand over case' : 'Assign coordinator' %></button>
                </form>
            </section>
        <% } %>
        <section class="panel rescue-followup">
            <h2 class="icon-heading"><%- include('icon', { name: 'notes' }) %>Care follow-up</h2>
            <a class="button primary" href="/animals/<%= animal._id %>/followups/new<%= carryReturn %>">
                <%- include('icon', { name: 'notes-plus' }) %>Add Follow-up
            </a>
        </section>
    <% } %>
</div>

<%- include('footer') %>
