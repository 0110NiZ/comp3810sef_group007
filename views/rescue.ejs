<%- include('header') %><div class="page-heading"><div><span class="eyebrow">RESCUE CARE</span><h1>救助管理</h1><p><%= animal.animalCode %> · <%= animal.appearance %></p></div><a class="button" href="/animals/<%= animal._id %>">返回详情</a></div><div class="form-layout"><section class="panel"><h2>负责人及安置</h2><form method="POST" action="/animals/<%= animal._id %>/rescue"><div class="form-grid"><label>救助进度<select name="rescueStatus"><% Object.entries(labels.rescueStatuses).forEach(([value,label]) => { %><option value="<%= value %>" <%= animal.rescueStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label><label>负责人<select name="assignedTo"><option value="">待指定</option><% users.forEach(user => { %><option value="<%= user._id %>" <%= animal.assignedTo === user._id ? 'selected' : '' %>><%= user.displayName %></option><% }) %></select></label><label class="full">安置地点<input name="placementLocation" value="<%= animal.placementLocation %>" placeholder="诊所、临时安置点或其他地点" maxlength="200"></label></div><%- include('form-actions', { cancelUrl: '/animals/' + animal._id, submitLabel: '保存救助更新' }) %></form></section><aside class="panel form-aside"><span class="aside-symbol">♡</span><h2>持续跟进每一步</h2><p>治疗情况和日常照护请记录在跟进记录中，方便其他成员接续工作。</p><ol class="steps"><li>待救助</li><li>救助中</li><li>已安置</li></ol><a class="button" href="/animals/<%= animal._id %>/followups/new">＋ 添加跟进记录</a></aside></div><%- include('footer') %>
