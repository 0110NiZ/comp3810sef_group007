<%
    const rescueTotal = rescueCounts.reduce(
        (sum, item) => sum + Number(item.count),
        0
    );
    const rescueColors = ['#ecc66e', '#8fbcd3', '#a9c77d'];
    let rescueOffset = 0;
%>

<section class="panel rescue-chart-panel">
    <h2 class="icon-heading"><%- include('icon', { name: 'paw' }) %>Rescue Status</h2>
    <div class="rescue-chart-content">
        <div class="rescue-donut">
            <svg viewBox="0 0 120 120" role="img"
                aria-label="Rescue status distribution: <%= rescueTotal %> animals">
                <circle cx="60" cy="60" r="43" fill="none" stroke="#ece6d8"
                    stroke-width="18" />
                <%
                    rescueCounts.forEach((item, index) => {
                        const percentage = rescueTotal
                            ? (Number(item.count) / rescueTotal) * 100
                            : 0;
                %>
                    <circle cx="60" cy="60" r="43" fill="none" stroke="<%= rescueColors[index % rescueColors.length] %>"
                        stroke-width="18" pathLength="100"
                        stroke-dasharray="<%= percentage %> <%= 100 - percentage %>"
                        stroke-dashoffset="<%= -rescueOffset %>" transform="rotate(-90 60 60)" />
                <% rescueOffset += percentage; }); %>
            </svg>
            <span>
                <strong><%= rescueTotal %></strong>
                <small>animals</small>
            </span>
        </div>
        <ul class="rescue-legend">
            <% rescueCounts.forEach((item, index) => { %>
                <li>
                    <i style="background: <%= rescueColors[index % rescueColors.length] %>"></i>
                    <span><%= item.label %></span>
                    <strong><%= item.count %></strong>
                    <small><%=
                        rescueTotal
                            ? ((item.count / rescueTotal) * 100).toFixed(1)
                            : '0.0'
                    %>%</small>
                </li>
            <% }); %>
        </ul>
    </div>
    <% if (!rescueTotal) { %>
        <p class="muted">No animal records yet.</p>
    <% } %>
</section>
