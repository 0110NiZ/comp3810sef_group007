<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in · Animal Rescue Center</title>
    <link rel="stylesheet" href="/login.css">
</head>
<body class="login-body">
    <main class="login-shell">
        <section class="login-story" aria-labelledby="center-name">
            <img class="login-shelter" src="/assets/cottage.svg" width="112" height="72" alt="">
            <div class="login-intro">
                <h1 id="center-name">Animal Rescue Center</h1>
                <p>Track rescues, record care notes and manage adoptions.</p>
            </div>
            <img class="login-companions" src="/assets/companions.svg" width="72" height="36" alt="">
        </section>

        <section class="login-form" aria-labelledby="sign-in-title">
            <h2 id="sign-in-title"><%- include('icon', { name: 'lock' }) %>Sign in</h2>
            <form method="POST" action="/login">
                <% if (typeof csrfToken === 'string' && csrfToken) { %>
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>
                <label>Username
                    <input name="username" type="text" autocomplete="username"
                        minlength="3" maxlength="40"
                        value="<%= typeof username === 'string' ? username : '' %>" required>
                </label>
                <label>Password
                    <input name="password" type="password" autocomplete="current-password" required>
                </label>
                <% if (typeof error === 'string' && error) { %>
                    <p class="form-feedback" role="alert"><%= error %></p>
                <% } %>
                <button type="submit">Sign in</button>
            </form>
            <p class="login-hint">Need an account? Ask your administrator.</p>
        </section>
    </main>
</body>
</html>
