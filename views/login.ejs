
<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>工作人员登录 · 栖伴</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="login-body">
    <main class="login-shell">

        <!-- 左侧：原有品牌展示区域，保持不变 -->
        <section class="login-story">
            <a class="brand" href="/">
                <span class="brand-mark">爪</span>
                <span>
                    栖伴
                    <small>动物救助与领养管理</small>
                </span>
            </a>

            <div>
                <span class="eyebrow">
                    A LITTLE CARE. A NEW BEGINNING.
                </span>

                <h1>
                    每一次守护，<br>
                    都值得被记录。
                </h1>

                <p>
                    连接发现、救助与领养，<br>
                    让它们离温暖的家更近一步。
                </p>

                <div class="login-animal" aria-hidden="true">
                    🐈　🐕
                </div>
            </div>

            <span class="story-bottom">
                救助有记录 · 跟进有责任 · 领养有归处
            </span>
        </section>

        <!-- 右侧：工作人员真实登录表单 -->
        <section class="login-form">
            <span class="eyebrow">WELCOME BACK</span>

            <h2>工作人员登录</h2>

            <p class="muted">开始今天的救助工作</p>

            <!--
                使用 POST 向 Express 的 /login 路由提交。
                不再使用原来的 method="dialog" 和 data-preview。
            -->
            <form method="POST" action="/login">

                <!--
                    为后续 CSRF 保护预留字段。
                    由服务器提供 csrfToken。
                -->
                <% if (typeof csrfToken === 'string' && csrfToken) { %>
                    <input
                        type="hidden"
                        name="_csrf"
                        value="<%= csrfToken %>"
                    >
                <% } %>

                <div class="form-stack">

                    <!-- 用户名 -->
                    <label>
                        用户名
                        <input
                            name="username"
                            type="text"
                            autocomplete="username"
                            placeholder="请输入用户名"
                            minlength="3"
                            maxlength="40"
                            value="<%= typeof username === 'string' ? username : '' %>"
                            required
                        >
                    </label>

                    <!-- 密码 -->
                    <label>
                        密码
                        <input
                            name="password"
                            type="password"
                            autocomplete="current-password"
                            placeholder="请输入密码"
                            required
                        >
                    </label>

                </div>

                <!-- 服务器返回登录失败原因时显示 -->
                <% if (typeof error === 'string' && error) { %>
                    <div class="form-feedback" role="alert">
                        <%= error %>
                    </div>
                <% } %>

                <p class="login-hint">
                    请使用已分配的工作人员账号登录。
                </p>

                <button
                    class="primary full-button"
                    type="submit"
                >
                    登录系统
                </button>

            </form>

            <p class="muted login-hint">
                仅限授权工作人员使用。
            </p>
        </section>

    </main>
</body>
</html>
