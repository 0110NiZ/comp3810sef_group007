<%- include('header') %><div class="page-heading"><div><span class="eyebrow">COMPLETE ADOPTION</span><h1>领养结案</h1><p>完成交接后保留档案，让每段救助都有记录。</p></div><a class="button" href="/animals/<%= animal._id %>/adoption">返回领养管理</a></div><section class="panel form-panel"><h2>核对结案信息</h2><dl><dt>动物编号</dt><dd><%= animal.animalCode %></dd><dt>外观</dt><dd><%= animal.appearance %></dd><dt>领养人</dt><dd><%= adoption ? adoption.adopterName : '尚未登记' %></dd><dt>联系电话</dt><dd><%= adoption ? adoption.adopterPhone : '尚未登记' %></dd><dt>领养状态</dt><dd><%= labels.adoptionStatuses[animal.adoptionStatus] %></dd></dl><form method="dialog" data-preview="领养结案" class="spaced"><label class="checkbox"><input type="checkbox" required>已核对领养资料及交接情况</label><%- include('form-actions', { cancelUrl: '/animals/' + animal._id, submitLabel: '预览结案确认' }) %></form></section><%- include('footer') %>
