<%- include('header') %>
<div class="page-heading"><div><span class="eyebrow">COMPLETE ADOPTION</span><h1><%= animal.closedAt ? '领养已结案' : '领养结案' %></h1><p>完成交接后保留档案，让每段救助都有记录。</p></div><a class="button" href="/animals/<%= animal._id %>/adoption">返回领养管理</a></div>
<% if (error) { %><div class="warning-box" role="alert"><p><%= error %></p><% if (stale) { %><a class="button" href="/animals/<%= animal._id %>/close">刷新并重新核对</a><% } %></div><% } %>
<section class="panel form-panel"><h2>核对结案信息</h2><dl><dt>动物编号</dt><dd><%= animal.animalCode %></dd><dt>外观</dt><dd><%= animal.appearance %></dd><dt>领养人</dt><dd><%= adoption ? adoption.adopterName : '尚未登记' %></dd><dt>联系电话</dt><dd><%= adoption ? adoption.adopterPhone : '尚未登记' %></dd><dt>领养状态</dt><dd><%= labels.adoptionStatuses[animal.adoptionStatus] %></dd><% if (animal.closedAt) { %><dt>结案时间</dt><dd><%= formatDate(animal.closedAt) %></dd><% } %></dl>
<% if (animal.closedAt) { %><p class="spaced">交接已完成，动物与领养档案已保留，本页只供查看。</p>
<% } else if (animal.adoptionStatus === 'processing' && adoption && !adoption.completedAt) { %>
<form method="POST" action="/animals/<%= animal._id %>/close" class="spaced"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adoptionId" value="<%= adoption._id %>"><input type="hidden" name="adoptionVersion" value="<%= adoption.__v || 0 %>"><label class="checkbox"><input type="checkbox" name="confirm" value="yes" required>已核对领养资料及交接情况</label><div class="form-bottom"><p>确认后结案，档案将保留。</p><button class="primary" type="submit" <%= stale ? 'disabled' : '' %>>完成领养并结案</button></div></form>
<% } else { %><p class="spaced">当前不能结案，请先完成领养登记。</p><% } %></section><%- include('footer') %>
