
<%- include('header') %>

<div class="page-heading">
    <div>
        <span class="eyebrow">ACCOUNT SECURITY</span>
        <h1>修改密码</h1>
        <p>为了保护救助资料，请定期检查账号安全。</p>
    </div>
    <a class="button" href="/profile">返回个人资料</a>
</div>

<section class="panel form-panel">
    <h2>设置新密码</h2>

    <% if (typeof error === 'string' && error) { %>
        <div class="form-feedback" role="alert"><%= error %></div>
    <% } %>
    <% if (typeof success === 'string' && success) { %>
        <div class="form-feedback" role="status"><%= success %></div>
    <% } %>

    <form method="POST" action="/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-stack">
            <label>当前密码
                <input type="password" name="currentPassword"
                       autocomplete="current-password" required>
            </label>
            <label>新密码
                <input type="password" name="newPassword"
                       autocomplete="new-password" minlength="8" maxlength="128"
                       placeholder="8–128 个字符" required>
            </label>
            <label>确认新密码
                <input type="password" name="confirmPassword"
                       autocomplete="new-password" minlength="8" maxlength="128" required>
            </label>
        </div>

        <div class="form-bottom">
            <p>修改成功后，其他设备的旧登录会话将失效。</p>
            <div class="actions">
                <a class="button" href="/profile">取消</a>
                <button class="primary" type="submit">保存新密码</button>
            </div>
        </div>
    </form>
</section>

<%- include('footer') %>
