<%- include('header') %>

<div class="page-heading">
    <div>
        <h1 class="pixel-page-title"><%- include('icon', { name: 'lock' }) %>Change Password</h1>
    </div>
    <a class="button" href="/profile">Back to My Account</a>
</div>

<section class="panel form-panel">
    <h2>Set a New Password</h2>
    <% if (typeof error === 'string' && error) { %>
        <div class="form-feedback" role="alert"> <%= error %> </div>
    <% } %>
    <% if (typeof success === 'string' && success) { %>
        <div class="form-feedback" role="status"> <%= success %> </div>
    <% } %>
    <form method="POST" action="/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-stack">
            <label>Current Password
                <input type="password" name="currentPassword"
                    autocomplete="current-password" required>
            </label>
            <label>New Password
                <input type="password" name="newPassword" autocomplete="new-password"
                    minlength="8" maxlength="128" placeholder="8–128 characters" required>
            </label>
            <label>Confirm New Password
                <input type="password" name="confirmPassword" autocomplete="new-password"
                    minlength="8" maxlength="128" required>
            </label>
        </div>
        <div class="form-bottom">
            <div class="actions">
                <a class="button" href="/profile">
                    <%- include('icon', { name: 'back' }) %> Cancel
                </a>
                <button class="primary" type="submit">
                    <%- include('icon', { name: 'shield' }) %> Save Password
                </button>
            </div>
        </div>
    </form>
</section>

<%- include('footer') %>
