<%- include('header') %><div class="page-heading"><div><span class="eyebrow">ACCOUNT SECURITY</span><h1>修改密码</h1><p>此处仅展示密码表单，请勿输入真实密码。</p></div><a class="button" href="/profile">返回个人资料</a></div><section class="panel form-panel"><h2>设置新密码</h2><form method="dialog" data-preview="修改密码" data-sensitive="true"><div class="form-stack"><label>当前密码<input type="password" name="currentPassword" autocomplete="current-password" required></label><label>新密码<input type="password" name="newPassword" autocomplete="new-password" required minlength="8" placeholder="至少 8 个字符"></label><label>确认新密码<input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8"></label></div><%- include('form-actions', { cancelUrl: '/profile', submitLabel: '预览密码修改' }) %></form></section><%- include('footer') %>
