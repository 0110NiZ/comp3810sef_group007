<%- include('header') %>

<div class="page-heading">
    <div>
        <span class="eyebrow">ACCOUNT SECURITY</span>
        <h1>Change Password</h1>
        <p>Keep your account secure to protect rescue records.</p>
    </div>
    <a class="button" href="/profile">Back to My Account</a>
</div>

<section class="panel form-panel">
    <h2>Set a New Password</h2>

    <% if (typeof error === 'string' && error) { %>
    <div class="form-feedback" role="alert">
        <%= error %>
    </div>
    <% } %>
    <% if (typeof success === 'string' && success) { %>
    <div class="form-feedback" role="status">
        <%= success %>
    </div>
    <% } %>

    <form method="POST" action="/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="form-stack">
            <label>Current Password
                <input type="password" name="currentPassword" autocomplete="current-password" required>
            </label>
            <label>New Password
                <input type="password" name="newPassword" autocomplete="new-password" minlength="8"
                    maxlength="128" placeholder="8–128 characters" required>
            </label>
            <label>Confirm New Password
                <input type="password" name="confirmPassword" autocomplete="new-password" minlength="8"
                    maxlength="128" required>
            </label>
        </div>

        <div class="form-bottom">
            <p>Changing your password signs out other sessions.</p>
            <div class="actions">
                <a class="button" href="/profile">Cancel</a>
                <button class="primary" type="submit">Save Password</button>
            </div>
        </div>
    </form>
</section>

<%- include('footer') %>
