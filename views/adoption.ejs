<%- include('header') %>

<%- include('work-return') %> <div class="page-heading">
    <div>
        <h1 class="pixel-page-title">
            <%- include('icon', { name: 'heart' }) %>Adoption Management
        </h1>
        <p class="adoption-record-heading">
            <span><%= animal.animalCode %></span>
            <span class="badge status-<%= animal.adoptionStatus %>">
                <%= labels.adoptionStatuses[animal.adoptionStatus] %>
            </span>
            <span>· Find a suitable home</span>
        </p>
    </div>
    <a class="button" href="/animals/<%= animal._id %>/close<%= returnQuery() %>">View Closure</a>
</div>
<% if (error) { %>
    <div class="warning-box" role="alert">
        <p> <%= error %> </p>
        <% if (stale) { %>
            <a class="button" href="/animals/<%= animal._id %>/adoption<%= carryReturn %>">
                Reload and
                Review</a>
        <% } %>
    </div>
<% } %>
<div class="form-layout adoption-workspace">
    <section class="panel">
        <h2> <%=
            animal.closedAt
                ? 'Closed Record'
                : adoption
                  ? 'Adoption Details'
                  : animal.adoptionStatus === 'not_open'
                    ? 'Open for Adoption'
                    : 'Register an Adopter'
        %> </h2>
        <%
            if (
                adoption &&
                animal.adoptionStatus === 'processing' &&
                !animal.closedAt
            ) {
        %>
            <p>Update the current adoption details here. If the adopter withdraws, cancel
                this adoption before registering another.</p>
            <form method="POST" action="/animals/<%= animal._id %>/adoption/edit<%= carryReturn %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="adoptionId" value="<%= adoption._id %>">
                <input type="hidden" name="adoptionVersion" value="<%= adoption.__v || 0 %>">
                <div class="form-grid">
                    <label>Adopter Name <em>*</em>
                        <input name="adopterName" value="<%=
                            error && formAction === 'edit'
                                    ? values.adopterName
                                    : adoption.adopterName
                        %>" required
                            maxlength="80">
                    </label>
                    <label>Phone Number <em>*</em>
                        <input type="tel" name="adopterPhone" value="<%=
                            error && formAction === 'edit'
                                    ? values.adopterPhone
                                    : adoption.adopterPhone
                        %>" required
                            maxlength="30">
                    </label>
                    <label class="full">Notes
                        <textarea name="remarks" rows="4"
                            maxlength="2000"><%=
                                error && formAction === 'edit'
                                        ? values.remarks
                                        : adoption.remarks
                            %></textarea>
                    </label>
                </div>
                <div class="form-bottom">
                    <p>Registered: <%= formatDate(adoption.createdAt) %> </p>
                    <button type="submit" class="primary" <%= stale ? 'disabled' : '' %>>
                        Save Adoption
                        Changes </button>
                </div>
            </form>
            <div class="panel-note">
                <p>Adopter withdrawing? Keep a record of the reason before starting
                    another adoption.</p>
                <a class="button cancel-adoption-button"
                    href="/animals/<%= animal._id %>/adoption/cancel<%= returnQuery() %>">Cancel This Adoption</a>
            </div>
        <% } else if (adoption) { %>
            <dl>
                <dt>Adopter Name</dt>
                <dd> <%= adoption.adopterName %> </dd>
                <dt>Phone Number</dt>
                <dd> <%= adoption.adopterPhone %> </dd>
                <dt>Notes</dt>
                <dd> <%= adoption.remarks || 'None' %> </dd>
                <dt>Registered At</dt>
                <dd> <%= formatDate(adoption.createdAt) %> </dd>
                <dt>Completed At</dt>
                <dd> <%= formatDate(adoption.completedAt) %> </dd>
            </dl>
            <p>Adoption completed. This record is retained for reference.</p>
        <% } else if (animal.adoptionStatus === 'available' && !animal.closedAt) { %>
            <form method="POST" action="/animals/<%= animal._id %>/adoption<%= carryReturn %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-grid">
                    <label>Adopter Name <em>*</em>
                        <input name="adopterName" value="<%= values.adopterName %>" required
                            maxlength="80" autocomplete="off">
                    </label>
                    <label>Phone Number <em>*</em>
                        <input type="tel" name="adopterPhone" value="<%= values.adopterPhone %>" required
                            maxlength="30" autocomplete="off">
                    </label>
                    <label class="full">Notes
                        <textarea name="remarks" rows="5"
                            maxlength="2000"><%= values.remarks %></textarea>
                    </label>
                </div>
                <div class="form-bottom">
                    <p>Saving starts the adoption process.</p>
                    <button class="primary" type="submit" <%= stale ? 'disabled' : '' %>>
                        <%- include('icon', { name: 'adoption' }) %>Register
                        Adoption </button>
                </div>
            </form>
        <% } else { %>
            <% if (animal.closedAt) { %>
                <p>This case is closed. Its records are read-only.</p>
            <% } else { %>
                <p>Review placement and health, then confirm that this animal is ready for
                    a new home.</p>
                <dl class="adoption-readiness">
                    <dt>Placement</dt>
                    <dd><%= animal.placementLocation || 'Not arranged' %></dd>
                    <dt>Health Condition</dt>
                    <dd><%= animal.healthStatus %></dd>
                </dl>
                <%
                    if (
                        !animal.closedAt &&
                        !adoption &&
                        animal.adoptionStatus === 'not_open'
                    ) {
                %>
                    <%
                        if (
                            animal.rescueStatus === 'placed' &&
                            animal.assignedTo &&
                            animal.placementLocation
                        ) {
                    %>
                        <form class="open-adoption-form" method="POST"
                            action="/animals/<%= animal._id %>/adoption-status<%= carryReturn %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <input type="hidden" name="adoptionStatus" value="available">
                            <label class="checkbox">
                                <input type="checkbox" name="healthConfirmed" value="yes"
                                    required>I confirm the animal is healthy enough for
                                adoption
                            </label>
                            <button
                                type="submit"
                                class="primary spaced"
                                <%= stale ? 'disabled' : '' %>
                            >
                                <%- include('icon', { name: 'heart-plus' }) %>Open for Adoption
                                </button>
                        </form>
                    <% } else { %>
                        <div class="warning-box">
                            <p>Assign a staff member and record placement before opening
                                adoption.</p>
                            <a class="button primary"
                                href="/animals/<%= animal._id %>/rescue<%= returnQuery() %>">Update
                                Rescue Details</a>
                        </div>
                    <% } %><% } %>
            <% } %>
        <% } %>
        <% if (adoption) { %>
            <a
                class="button primary spaced"
                href="/animals/<%= animal._id %>/close<%= returnQuery() %>"
            >
                <%= animal.closedAt ? 'View Closed Record' : 'Complete Adoption' %> →</a>
        <% } %>
    </section>
    <aside class="panel form-aside">
        <h2 class="icon-heading">
            <span class="heading-icon">
                <%- include('icon', { name: 'heart' }) %>
            </span>
            Animal Summary
        </h2>
        <dl>
            <dt>Rescue Progress</dt>
            <dd> <%= labels.rescueStatuses[animal.rescueStatus] %> </dd>
            <dt>Health Condition</dt>
            <dd> <%= animal.healthStatus %> </dd>
            <dt>Placement Location</dt>
            <dd> <%= animal.placementLocation || 'Not placed' %> </dd>
        </dl>
        <%
            if (
                !animal.closedAt &&
                !adoption &&
                animal.adoptionStatus === 'available'
            ) {
        %>
            <form method="POST" action="/animals/<%= animal._id %>/adoption-status<%= carryReturn %>"
                class="spaced">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="adoptionStatus" value="not_open">
                <button type="submit" <%= stale ? 'disabled' : '' %>>Withdraw Availability</button>
            </form>
        <% } %>
        <%
            if (
                currentUser &&
                currentUser.role === 'admin' &&
                !animal.closedAt &&
                animal.adoptionStatus !== 'adopted'
            ) {
        %>
            <a
                class="button spaced"
                href="/animals/<%= animal._id %>/delete<%= returnQuery() %>"
            >Delete
                Incorrect Record</a>
        <% } %>
    </aside>
</div>
<% if (adoptionHistory.length) { %>
    <section class="panel spaced">
        <h2>Cancelled Adoptions</h2>
        <p>These entries are retained for reference and cannot be changed or cancelled
            again.</p>
        <% adoptionHistory.forEach(entry => { %>
            <article class="history">
                <h3> <%= entry.adopterName %> · Cancelled</h3>
                <dl>
                    <dt>Phone Number</dt>
                    <dd> <%= entry.adopterPhone %> </dd>
                    <dt>Registration Notes</dt>
                    <dd> <%= entry.remarks || 'None' %> </dd>
                    <dt>Cancellation Reason</dt>
                    <dd> <%= entry.cancellationReason %> </dd>
                    <dt>Cancelled At</dt>
                    <dd> <%= formatDate(entry.cancelledAt) %> </dd>
                    <dt>Performed By</dt>
                    <dd> <%=
                        entry.cancelledBy
                            ? entry.cancelledBy.displayName
                            : 'Former Staff Member'
                    %> </dd>
                </dl>
            </article>
        <% }) %>
    </section>
<% } %>

<%- include('footer') %>
