<%- include('header') %>
<div class="page-heading"><div><span class="eyebrow">A NEW HOME</span><h1>领养管理</h1><p><%= animal.animalCode %> · 为它寻找合适的新家</p></div><a class="button" href="/animals/<%= animal._id %>/close">查看结案信息</a></div>
<% if (error) { %><div class="warning-box" role="alert"><p><%= error %></p><% if (stale) { %><a class="button" href="/animals/<%= animal._id %>/adoption">刷新并重新核对</a><% } %></div><% } %>
<div class="form-layout"><section class="panel"><h2><%= adoption ? '领养登记资料' : '领养人登记' %></h2>
<% if (adoption && animal.adoptionStatus === 'processing' && !animal.closedAt) { %>
<p>办理中可修改联系方式和备注；领养人放弃时，请取消本次办理，再重新登记。</p>
<form method="POST" action="/animals/<%= animal._id %>/adoption/edit">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adoptionId" value="<%= adoption._id %>"><input type="hidden" name="adoptionVersion" value="<%= adoption.__v || 0 %>">
<div class="form-grid"><label>领养人姓名 <em>*</em><input name="adopterName" value="<%= error && formAction === 'edit' ? values.adopterName : adoption.adopterName %>" required maxlength="80"></label><label>联系电话 <em>*</em><input type="tel" name="adopterPhone" value="<%= error && formAction === 'edit' ? values.adopterPhone : adoption.adopterPhone %>" required maxlength="30"></label><label class="full">备注<textarea name="remarks" rows="4" maxlength="2000"><%= error && formAction === 'edit' ? values.remarks : adoption.remarks %></textarea></label></div>
<div class="form-bottom"><p>登记时间：<%= formatDate(adoption.createdAt) %></p><button type="submit" class="primary" <%= stale ? 'disabled' : '' %>>保存领养资料修改</button></div></form>
<div class="warning-box spaced"><h3>取消本次领养办理</h3><p>取消后动物回到“可领养”，本次登记和取消说明仍会保留。</p>
<form method="POST" action="/animals/<%= animal._id %>/adoption/cancel">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adoptionId" value="<%= adoption._id %>"><input type="hidden" name="adoptionVersion" value="<%= adoption.__v || 0 %>">
<label>取消原因 <em>*</em><textarea name="cancellationReason" rows="3" required maxlength="1000"><%= values.cancellationReason %></textarea></label>
<label class="checkbox spaced"><input type="checkbox" name="confirm" value="yes" required>确认取消本次办理并保留历史记录</label><button type="submit" class="spaced" <%= stale ? 'disabled' : '' %>>取消本次领养办理</button></form></div>
<% } else if (adoption) { %>
<dl><dt>领养人姓名</dt><dd><%= adoption.adopterName %></dd><dt>联系电话</dt><dd><%= adoption.adopterPhone %></dd><dt>备注</dt><dd><%= adoption.remarks || '无' %></dd><dt>登记时间</dt><dd><%= formatDate(adoption.createdAt) %></dd><dt>完成时间</dt><dd><%= formatDate(adoption.completedAt) %></dd></dl><p>领养已完成，档案保留供查阅。</p>
<% } else if (animal.adoptionStatus === 'available' && !animal.closedAt) { %>
<form method="POST" action="/animals/<%= animal._id %>/adoption"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-grid"><label>领养人姓名 <em>*</em><input name="adopterName" value="<%= values.adopterName %>" required maxlength="80" autocomplete="off"></label><label>联系电话 <em>*</em><input type="tel" name="adopterPhone" value="<%= values.adopterPhone %>" required maxlength="30" autocomplete="off"></label><label class="full">备注<textarea name="remarks" rows="5" maxlength="2000"><%= values.remarks %></textarea></label></div><div class="form-bottom"><p>保存后进入领养办理中。</p><button class="primary" type="submit" <%= stale ? 'disabled' : '' %>>保存领养登记</button></div></form>
<% } else { %><p>暂无领养登记。请先确认安置和健康情况，再开放领养。</p><% } %>
</section><aside class="panel form-aside"><span class="aside-symbol">⌂</span><h2>领养进度</h2><span class="badge status-<%= animal.adoptionStatus %>"><%= labels.adoptionStatuses[animal.adoptionStatus] %></span>
<dl><dt>救助进度</dt><dd><%= labels.rescueStatuses[animal.rescueStatus] %></dd><dt>健康状况</dt><dd><%= animal.healthStatus %></dd><dt>安置地点</dt><dd><%= animal.placementLocation || '尚未安置' %></dd></dl>
<% if (!animal.closedAt && !adoption && animal.adoptionStatus === 'not_open') { %>
<% if (animal.rescueStatus === 'placed' && animal.assignedTo && animal.placementLocation) { %>
<form method="POST" action="/animals/<%= animal._id %>/adoption-status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adoptionStatus" value="available"><label class="checkbox"><input type="checkbox" name="healthConfirmed" value="yes" required>我已确认健康状况适宜领养</label><button type="submit" class="primary spaced" <%= stale ? 'disabled' : '' %>>开放领养</button></form>
<% } else { %><p>完成负责人分配和安置后，可开放领养。</p><% } %><% } %>
<% if (!animal.closedAt && !adoption && animal.adoptionStatus === 'available') { %><form method="POST" action="/animals/<%= animal._id %>/adoption-status" class="spaced"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="adoptionStatus" value="not_open"><button type="submit" <%= stale ? 'disabled' : '' %>>撤回开放领养</button></form><% } %>
<% if (adoption) { %><a class="button primary spaced" href="/animals/<%= animal._id %>/close"><%= animal.closedAt ? '查看结案档案' : '进入结案页面' %> →</a><% } %>
<% if (currentUser && currentUser.role === 'admin' && !animal.closedAt && animal.adoptionStatus !== 'adopted') { %><a class="button spaced" href="/animals/<%= animal._id %>/delete">删除误录档案</a><% } %>
</aside></div>
<% if (adoptionHistory.length) { %><section class="panel spaced"><h2>已取消的领养办理记录</h2><p>下列记录仅供追溯，不能继续修改、结案或再次取消。</p>
<% adoptionHistory.forEach(entry => { %><article class="history"><h3><%= entry.adopterName %> · 已取消</h3><dl><dt>联系电话</dt><dd><%= entry.adopterPhone %></dd><dt>登记备注</dt><dd><%= entry.remarks || '无' %></dd><dt>取消原因</dt><dd><%= entry.cancellationReason %></dd><dt>取消时间</dt><dd><%= formatDate(entry.cancelledAt) %></dd><dt>操作人</dt><dd><%= entry.cancelledBy ? entry.cancelledBy.displayName : '历史工作人员' %></dd></dl></article><% }) %>
</section><% } %><%- include('footer') %>
