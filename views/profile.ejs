<%- include('header') %>
<div class="page-heading">
    <div>
        <span class="eyebrow">YOUR WORKSPACE IDENTITY</span>
        <h1 class="pixel-page-title"><%- include('icon', { name: 'user' }) %>My Account</h1>
        <p>Keep your contact details up to date for your team.</p>
    </div>
</div>
<% if (error) { %>
<p class="warning-box" role="alert">
    <%= error %>
</p>
<% } %>
<% if (success) { %>
<p class="form-feedback" role="status">
    <%= success %>
</p>
<% } %>
<section class="panel account-summary">
    <span class="profile-avatar"><%- include('icon', { name: 'user' }) %><span class="avatar-initial">
        <%= profile.displayName.slice(0, 1).toUpperCase() %>
        </span>
    </span>
    <div>
        <h2>
            <%= profile.displayName %>
        </h2>
        <p class="muted">@<%= profile.username %>
        </p>
    </div>
    <span class="badge status-placed">
        <%= profile.role === 'admin' ? 'Administrator' : 'Staff' %>
    </span>
</section>
<div class="account-layout spaced">
    <section class="panel">
        <div class="section-heading">
            <h2 class="icon-heading">
                <span class="heading-icon"><%- include('icon', { name: 'user' }) %></span>Contact Details
            </h2>
            <span class="muted">Visible to your team</span>
        </div>
        <form method="POST" action="/profile">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid">
                <label>Display Name <em>*</em>
                    <input name="displayName" value="<%= profile.displayName %>" required maxlength="80"
                        autocomplete="name">
                </label>
                <label>Phone Number
                    <input type="tel" name="phone" value="<%= profile.phone || '' %>" maxlength="30"
                        autocomplete="tel" placeholder="Work contact number">
                </label>
            </div>
            <div class="form-bottom">
                <p>Your username and role are managed separately.</p>
                <button type="submit" class="primary"><%- include('icon', { name: 'check' }) %> Save Changes</button>
            </div>
        </form>
    </section>
    <section class="panel security-panel">
        <span class="eyebrow">ACCOUNT SECURITY</span>
        <h2 class="icon-heading">
            <span class="heading-icon"><%- include('icon', { name: 'shield' }) %></span>Password & Security
        </h2>
        <p>Use a unique password. Changing it signs out your other sessions.</p>
        <a class="button spaced" href="/password">Change Password →</a>
        <div class="panel-note">
            <strong>Access level</strong>
            <p>
                <%= profile.role === 'admin' ? 'Manage staff accounts and remove incorrect open records, alongside daily rescue work.' : 'Manage animal care, follow-ups and adoption. Account administration is restricted.' %>
            </p>
        </div>
    </section>
</div>
<%- include('footer') %>
