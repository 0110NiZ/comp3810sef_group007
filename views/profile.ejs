<%- include('header') %>

<div class="page-heading">
    <h1 class="pixel-page-title">
        <%- include('icon', { name: 'user' }) %><%= editing ? 'Edit Profile' : 'My Account' %>
    </h1>
</div>

<div class="<%= editing ? 'account-edit' : 'account-overview' %>">
    <section class="panel employee-profile">
        <% if (editing) { %>
            <% if (error) { %>
                <p class="warning-box" role="alert"><%= error %></p>
            <% } %>
            <form method="POST" action="/profile">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-grid">
                    <label>Display Name <em>*</em>
                        <input name="displayName" value="<%= profile.displayName %>" required maxlength="80"
                            autocomplete="name">
                    </label>
                    <%- include('phone-field', { name: 'phone', value: profile.phone, required: false }) %>
                </div>
                <div class="actions spaced">
                    <a class="button" href="/profile">Cancel</a>
                    <button type="submit" class="primary">
                        <%- include('icon', { name: 'check' }) %> Save Changes
                    </button>
                </div>
            </form>
        <% } else { %>
            <% if (success) { %>
                <p role="status" class="form-feedback"><%= success %></p>
            <% } %>
            <div class="profile-heading">
                <img class="staff-portrait" src="/assets/staff-portrait.svg" alt="">
                <div>
                    <h2><%= profile.displayName %></h2>
                    <p>@<%= profile.username %></p>
                    <span class="badge status-placed">
                        <%= profile.role === 'admin' ? 'Administrator' : 'Staff' %>
                    </span>
                </div>
                <a class="button primary" href="/profile?edit=1">Edit Profile</a>
            </div>
            <dl class="profile-phone">
                <dt>Phone Number</dt>
                <dd><%= profile.phone || 'Not provided' %></dd>
            </dl>
            <div class="profile-password">
                <h2 class="icon-heading"><%- include('icon', { name: 'lock' }) %>Password</h2>
                <a class="button" href="/password">Change Password</a>
            </div>
        <% } %>
    </section>

    <% if (!editing) { %>
        <div class="account-workspace">
            <% if (profile.role === 'admin') { %>
                <section class="panel account-unassigned">
                    <h2 class="icon-heading"><%- include('icon', { name: 'care' }) %>Unassigned cases
                        <span class="my-work-count"><%= unassignedCount %></span>
                    </h2>
                    <a class="button" href="/rescue-management?assignedTo=unassigned">Assign cases →</a>
                </section>
            <% } %>
            <section class="panel my-work" aria-labelledby="my-work-title">
                <h2 class="icon-heading" id="my-work-title"><%- include('icon', { name: 'notes' }) %>My Work</h2>
                <section class="account-work-section">
                    <div class="account-work-heading">
                        <h3>Assigned to Me <span class="my-work-count"><%= assignedCount %></span></h3>
                        <a class="button" href="/rescue-management?assignedTo=me">View all <%= assignedCount %> →</a>
                    </div>
                    <% if (assignedAnimals.length) { %>
                        <div class="account-table-wrap">
                            <table class="account-cases">
                                <thead><tr><th scope="col">Animal</th><th scope="col">Rescue status</th><th scope="col">Next Follow-up</th></tr></thead>
                                <tbody>
                                    <% for (const animal of assignedAnimals) { %>
                                        <tr>
                                            <td><div class="account-animal">
                                                <span class="work-animal-icon"><%- include('pet-avatar', { animal }) %></span>
                                                <div><a href="/animals/<%= animal._id %>"><%= animal.animalCode %></a><p><%= animal.appearance %></p></div>
                                            </div></td>
                                            <td><span class="badge status-<%= animal.rescueStatus %>"><%= labels.rescueStatuses[animal.rescueStatus] %></span></td>
                                            <td><span class="account-due due-<%= animal.followUpState %>" title="<%= animal.nextFollowUpDate || 'No date set' %>"><%= animal.followUpLabel %></span></td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %><p>No open cases assigned to you.</p><% } %>
                </section>
                <section class="account-work-section">
                    <div class="account-work-heading">
                        <h3 class="icon-heading"><%- include('icon', { name: 'notes' }) %>My recent notes</h3>
                        <a class="button" href="/followup-records?tab=mine">View all notes →</a>
                    </div>
                    <% for (const note of recentNotes) { %>
                        <article class="account-note">
                            <p class="account-note-meta">
                                <% if (note.animalId) { %>
                                    <a href="/animals/<%= note.animalId._id %>#care-journal"><%= note.animalId.animalCode %></a>
                                <% } else { %><span>Animal unavailable</span><% } %>
                                <time datetime="<%= note.createdAt.toISOString() %>"><%= formatDate(note.createdAt) %></time>
                            </p>
                            <p class="account-note-preview"><%= note.content %></p>
                        </article>
                    <% } %>
                    <% if (!recentNotes.length) { %><p>No follow-ups yet.</p><% } %>
                </section>
            </section>
        </div>
    <% } %>
</div>

<%- include('footer') %>
