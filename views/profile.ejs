<%- include('header') %>

<div class="page-heading">
    <h1 class="pixel-page-title">
        <%- include('icon', { name: 'user' }) %><%= editing ? 'Edit Profile' : 'My Account' %>
    </h1>
</div>

<section class="panel employee-profile">
    <% if (editing) { %>
        <% if (error) { %>
            <p class="warning-box" role="alert"><%= error %></p>
        <% } %>
        <form method="POST" action="/profile">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-grid">
                <label>Display Name <em>*</em>
                    <input name="displayName" value="<%= profile.displayName %>" required maxlength="80"
                        autocomplete="name">
                </label>
                <label>Phone Number
                    <input type="tel" name="phone" value="<%= profile.phone || '' %>" maxlength="30"
                        autocomplete="tel" placeholder="Work contact number">
                </label>
            </div>
            <div class="actions spaced">
                <a class="button" href="/profile">Cancel</a>
                <button type="submit" class="primary">
                    <%- include('icon', { name: 'check' }) %> Save Changes
                </button>
            </div>
        </form>
    <% } else { %>
        <div class="section-heading profile-heading">
            <span class="profile-avatar" aria-hidden="true">
                <%- include('icon', { name: 'user' }) %>
            </span>
            <div>
                <h2><%= profile.displayName %></h2>
                <% if (success) { %>
                    <span role="status"><%= success %></span>
                <% } %>
            </div>
        </div>
        <dl class="employee-fields">
            <div>
                <dt>Username</dt>
                <dd><%= profile.username %></dd>
            </div>
            <div>
                <dt>Role</dt>
                <dd><%= profile.role === 'admin' ? 'Administrator' : 'Staff' %></dd>
            </div>
            <div>
                <dt>Phone Number</dt>
                <dd><%= profile.phone || 'Not provided' %></dd>
            </div>
        </dl>
        <div class="actions">
            <a class="button primary" href="/profile?edit=1">Edit Profile</a>
            <a class="button" href="/password">Change Password</a>
        </div>
    <% } %>
</section>

<% if (!editing) { %>
    <section class="panel my-work" aria-labelledby="my-work-title">
        <h2 class="icon-heading" id="my-work-title">
            <%- include('icon', { name: 'notes' }) %>My Work
        </h2>
        <div class="my-work-links">
            <a class="my-work-link" href="/rescue-management?assignedTo=me">
                <span class="heading-icon"><%- include('icon', { name: 'care' }) %></span>
                <span>
                    <strong>Assigned to Me</strong>
                    <span>Open rescue cases I am responsible for</span>
                </span>
                <span class="my-work-count"><%= workCounts.assignedAnimalCount %></span>
            </a>
            <a class="my-work-link" href="/followup-records?tab=mine">
                <span class="heading-icon"><%- include('icon', { name: 'notes' }) %></span>
                <span>
                    <strong>My Follow-ups</strong>
                    <span>Follow-up notes I have recorded</span>
                </span>
                <span class="my-work-count"><%= workCounts.followUpCount %></span>
            </a>
        </div>
    </section>
<% } %>

<%- include('footer') %>
