<%- include('header') %>

<div class="page-heading">
    <div>
        <h1 class="pixel-page-title">
            <%- include('icon', { name: 'paw-plus' }) %>Register an Animal
        </h1>
    </div>
    <a class="button" href="/animals">Back to List</a>
</div>

<section class="panel">
    <h2 class="icon-heading"><%- include('icon', { name: 'paw' }) %>Animal Information</h2>
    <% if (error) { %>
        <p class="form-feedback" role="alert"> <%= error %> </p>
    <% } %>
    <form method="POST" action="/animals/new">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <%- include('animal-fields', { animal }) %>
        <div class="form-actions actions">
            <a class="button" href="/animals">
                <%- include('icon', { name: 'back' }) %> Cancel
            </a>
            <button class="primary" type="submit">
                <%- include('icon', { name: 'paw-plus' }) %> Register Animal
            </button>
        </div>
    </form>
</section>

<%- include('footer') %>
