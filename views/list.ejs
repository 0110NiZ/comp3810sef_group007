<%- include('header') %>
<div class="page-heading"><div><span class="eyebrow">ANIMAL RECORDS</span><h1>动物档案</h1><p>按类型、地点及状态查找动物档案</p></div><a class="button primary" href="/animals/new">＋ 新增动物</a></div>
<section class="panel">
<form method="get" action="/animals" class="filters">
<label>动物类型<select name="animalType"><option value="">全部类型</option><% Object.entries(labels.animalTypes).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.animalType === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>发现地点<input name="foundLocation" placeholder="输入地点关键词" value="<%= filters.foundLocation %>"></label>
<label>救助进度<select name="rescueStatus"><option value="">全部进度</option><% Object.entries(labels.rescueStatuses).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.rescueStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>领养状态<select name="adoptionStatus"><option value="">全部状态</option><% Object.entries(labels.adoptionStatuses).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.adoptionStatus === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label>
<label>排序<select name="sort"><% Object.entries({updated_desc:'最近更新优先', updated_asc:'最早更新优先', created_desc:'最新登记优先', created_asc:'最早登记优先'}).forEach(([value, label]) => { %><option value="<%= value %>" <%= filters.sort === value ? 'selected' : '' %>><%= label %></option><% }) %></select></label><div class="filter-actions"><button class="primary" type="submit">查询</button><a class="button" href="/animals">重置</a></div>
</form>
<div class="table-wrap"><table><thead><tr><th>编号 / 外观</th><th>类型</th><th>发现地点</th><th>救助进度</th><th>领养状态</th><th>操作</th></tr></thead><tbody><% animals.forEach(animal => { %><tr><td><strong class="animal-id"><span class="mini-animal" aria-hidden="true"><%= animal.animalType === 'cat' ? '🐈' : '🐕' %></span><%= animal.animalCode %></strong><p><%= animal.appearance %></p></td><td><%= labels.animalTypes[animal.animalType] %></td><td><%= animal.foundLocation %></td><td><span class="badge status-<%= animal.rescueStatus %>"><%= labels.rescueStatuses[animal.rescueStatus] %></span></td><td><span class="badge status-<%= animal.adoptionStatus %>"><%= labels.adoptionStatuses[animal.adoptionStatus] %></span></td><td><a href="/animals/<%= animal._id %>">详情</a></td></tr><% }) %><% if (!animals.length) { %><tr><td colspan="6" class="empty">没有符合条件的记录，请调整筛选条件。</td></tr><% } %></tbody></table></div>
<div class="pagination"><span>共 <%= total %> 条记录 · 每页 3 条</span><div><% if (page > 1) { %><a class="button" href="<%= pageUrl(page - 1) %>">上一页</a><% } else { %><button disabled>上一页</button><% } %><span>第 <%= page %> / <%= pageCount %> 页</span><% if (page < pageCount) { %><a class="button" href="<%= pageUrl(page + 1) %>">下一页</a><% } else { %><button disabled>下一页</button><% } %></div></div>
</section><%- include('footer') %>
